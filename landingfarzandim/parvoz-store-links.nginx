# ─────────────────────────────────────────────────────────────────────
# Qisqa yuklab olish havolalari (2026-09-25)
#
# Reklama / Telegram / vizitka uchun: odam havolani bossa TO'G'RIDAN-TO'G'RI
# kerakli do'kon sahifasiga tushadi.
#
#   farzandimedu.uz/ota-ona  (=/parent)  → ota-ona ilovasi
#        iPhone/iPad → App Store, qolgan hamma → Google Play
#   farzandimedu.uz/bola     (=/growth)  → Parvoz Growth (bola ilovasi)
#        faqat Android — bola ilovasi App Store'da YO'Q
#
# `map` faqat http konteksida ishlaydi, shuning uchun site konfigida emas,
# shu faylda (nginx.conf: include /etc/nginx/conf.d/*.conf).
# ─────────────────────────────────────────────────────────────────────

map $http_user_agent $parvoz_parent_store {
    default                "https://play.google.com/store/apps/details?id=com.farzandim.parent";
    "~*(iPhone|iPad|iPod)" "https://apps.apple.com/app/id6798972223";
}
