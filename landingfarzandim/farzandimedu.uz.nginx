# ─────────────────────────────────────────────────────────────────────
# farzandimedu.uz — ASOSIY domen (production)
# ─────────────────────────────────────────────────────────────────────
#   /            → landing (statik SPA, /var/www/farzandim-landing)
#   /api         → YANGI backend (NestJS, :3100)
#   /socket.io/  → YANGI backend realtime (:3100)
#   /storage/    → YANGI MinIO public (:9100)
#   /app/        → Flutter parent web + APK (farzandim-parent.apk)
#   /child/      → Flutter child web + APK (farzandim-child.apk)
#   /kirolmaysan → admin panel (Next.js, :3101, basePath=/kirolmaysan)
#
# Eski stack (:3000 backend, :9000 MinIO, /admin Flutter) OLIB TASHLANDI —
# yangi platforma asosiy domenga ko'chirildi (test.* dan).

# HTTP → HTTPS redirect
server {
    listen 80;
    listen [::]:80;
    server_name farzandimedu.uz www.farzandimedu.uz;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# HTTPS — asosiy server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name farzandimedu.uz www.farzandimedu.uz;

    ssl_certificate /etc/letsencrypt/live/farzandimedu.uz/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/farzandimedu.uz/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
    client_max_body_size 110M;

    # ── YANGI backend API (:3100) ─────────────────────────────────────
    location /api {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Realtime (socket.io) → :3100
    location /socket.io/ {
        proxy_pass http://127.0.0.1:3100;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 86400s;
    }

    # ── YANGI MinIO public obyektlar (:9100) ──────────────────────────
    location /storage/ {
        proxy_pass http://127.0.0.1:9100/;
        proxy_set_header Host $host;
    }

    # ── Admin panel (Next.js :3101, basePath=/kirolmaysan) ────────────
    # ⚠️ Manzil ATAYLAB oddiy emas: '/admin' avtomatik skanerlarning
    # birinchi urinishi. Bu himoyaning O'RNINI BOSMAYDI (parol va
    # urinishlar chegarasi asosiy), lekin shovqinni kamaytiradi.
    # next.config.ts dagi `basePath` bilan BIR XIL bo'lishi SHART —
    # mos kelmasa panel butunlay ochilmaydi.
    location /kirolmaysan {
        proxy_pass http://127.0.0.1:3101;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # ── Flutter parent web + APK ──────────────────────────────────────
    location /app/ {
        alias /home/farzandim/new-platform/flutter/parent/;
        try_files $uri $uri/ /app/index.html;
    }

    # ── Flutter child web + APK ───────────────────────────────────────
    location /child/ {
        alias /home/farzandim/new-platform/flutter/child/;
        try_files $uri $uri/ /child/index.html;
    }

    # ── Qisqa yuklab olish havolalari (2026-09-25) ────────────────────
    # Reklama/Telegram uchun: havola bosilsa to'g'ridan-to'g'ri do'konga.
    #   /ota-ona (=/parent) → iPhone'da App Store, qolganida Google Play
    #   /bola    (=/growth) → Parvoz Growth (bola ilovasi faqat Android)
    # $parvoz_parent_store — /etc/nginx/conf.d/parvoz-store-links.conf
    # ichidagi `map` (map faqat http konteksida ishlaydi, shu sababli
    # alohida faylda; nusxasi: landingfarzandim/parvoz-store-links.nginx).
    location = /ota-ona { return 302 $parvoz_parent_store; }
    location = /parent  { return 302 $parvoz_parent_store; }
    location = /bola    { return 302 "https://play.google.com/store/apps/details?id=com.farzandim.growth"; }
    location = /growth  { return 302 "https://play.google.com/store/apps/details?id=com.farzandim.growth"; }

    # ── Landing (root) ────────────────────────────────────────────────
    # ⚠️ Jonli konfigda bu blok :3200 (pm2 parvoz-landing, SSR) ga
    # proxy_pass qiladi — quyidagi statik variant eskirgan.
    location / {
        root /var/www/farzandim-landing;
        index index.html;
        try_files $uri $uri/ /index.html;
    }
}
