  permission  String // camera|microphone|location|contacts|sms|calendar|phone|storage
  allowed     Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, packageName, permission])
  @@index([childId, permission])
  @@map("app_permission_policies")
}

// ============================================
// ADMIN PANEL — Kontentlar (Sprint 5.6)
// Videolar, audiokitoblar, kitoblar, o'yinlar + umumiy kategoriya jadval.
// Bu PR'da MinIO multipart upload yo'q — URL-asoslangan create (admin
// CDN/YouTube link kiritadi). Multipart upload Sprint 5.6b'da.
// ============================================
model ContentCategory {
  id        String   @id @default(uuid())
  kind      String // video | audiobook | book | game
  slug      String
  name      String
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([kind, slug])
  @@index([kind])
  @@map("content_categories")
}

model Video {
  id              String   @id @default(uuid())
  title           String
  description     String?
  url             String
  thumbnail       String?
  // Sprint 5.6c — MinIO storage path. Bo'sh bo'lsa demoq url/thumbnail tashqi
  // CDN; bor bo'lsa har consumer fetch'da signed URL qayta generatsiya qilinadi.
  storageKey      String?  @map("storage_key")
  thumbStorageKey String?  @map("thumb_storage_key")
  durationSec     Int?     @map("duration_sec")
  ageFrom         Int      @default(0) @map("age_from")
  ageTo           Int      @default(18) @map("age_to")
  categoryId      String?  @map("category_id")
  category        String? // legacy denorm slug
  planRequired    String   @default("free") @map("plan_required")
  level           String? // beginner | intermediate | advanced
  status          String   @default("pending") // pending | approved | rejected | hidden
  featured        Boolean  @default(false)
  views           Int      @default(0)
  likes           Int      @default(0)
  // DON mukofoti — bola videoni TO'LIQ ko'rgach beriladi (admin kiritadi).
  // Audiobook.xpReward bilan bir xil uslub. 0 = mukofot yo'q.
  xpReward        Int      @default(0) @map("xp_reward")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  // Bola-scoped ko'rish tarixi + yoqtirilganlar (cascade — video o'chsa tozalanadi)
  childViews     ChildVideoView[]
  childFavorites ChildVideoFavorite[]

  @@index([status])
  @@index([categoryId])
  @@index([planRequired])
  @@index([featured])
  @@map("videos")
}

// ============================================
// BOLA VIDEO ENGAGEMENT — ko'rish tarixi + yoqtirilgan (child app feed header)
// ============================================

// Bola qaysi videoni ko'rgani — "Ko'rish tarixi". Har (bola, video) juftligi
