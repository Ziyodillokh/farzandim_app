// ─────────────────────────────────────────────────────────────────────
// ListenSession — ota-ona bola atrofidagi ovozni JONLI eshitish sessiyasi.
//
// ⚠️ OVOZ HECH QAYERDA SAQLANMAYDI. Bu jadval faqat SESSIYA METADATASINI
// (kim, qachon, qancha, kim tugatdi) yozadi — hisobdorlik uchun. Ovozning
// O'ZI WebRTC orqali to'g'ridan-to'g'ri bola→ota-ona telefoniga o'tadi,
// serverga tegmaydi va faylga yozilmaydi.
//
// Qonuniylik sharti (Google Play farzand-nazorati istisnosi): bola
// qurilmasida "Ota-onangiz tinglamoqda" indikatori DOIM ko'rinadi va bola
// istalgan payt to'xtata oladi. Bu YASHIRIN KUZATUV EMAS — ochiqligi uni
// stalkerware'dan ajratadi.
model ListenSession {
  id        String              @id @default(uuid())
  parentId  String              @map("parent_id")
  childId   String              @map("child_id")
  status    ListenSessionStatus @default(PENDING)
  startedAt DateTime            @default(now()) @map("started_at")
  endedAt   DateTime?           @map("ended_at")
  // Kim tugatdi: 'parent' | 'child' | 'timeout' | 'disconnect'.
  endedBy   String?             @map("ended_by")
  // Bola qurilmasi shu vaqtgacha ulanmasa PENDING → EXPIRED.
  expiresAt DateTime            @map("expires_at")

  parent User  @relation("ParentListenSessions", fields: [parentId], references: [id], onDelete: Cascade)
  child  Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, status])
  @@index([parentId, startedAt])
  @@map("listen_sessions")
}

enum ListenSessionStatus {
  PENDING // ota-ona boshladi, bola hali ulanmagan
  ACTIVE // jonli eshitish davom etmoqda
  ENDED // biror tomon to'xtatdi
  EXPIRED // bola ulanmadi (offline/ilova yopiq)
}

enum PhotoRequestStatus {
  PENDING
  COMPLETED
  DECLINED
}

