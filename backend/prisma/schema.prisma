// Farzandim Backend Schema
// Generated: 2026-05-13

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USERS - Parent va Child
// ============================================
model User {
  id           String   @id @default(uuid())
  phone        String?  @unique
  email        String?  @unique
  passwordHash String?  @map("password_hash") // null = social-only (Telegram/Google/Apple) foydalanuvchi
  role         UserRole
  name         String?
  telegramId   String?  @unique @map("telegram_id")
  // Google OAuth — Google ID token'dagi `sub` (Google subject ID). Bir
  // marta o'zgarmas, email o'zgarsa ham bog'liqlik buzilmaydi.
  googleSub    String?  @unique @map("google_sub")
  // Apple Sign In — Apple ID token'dagi `sub`. Apple email odatda foydalanuvchi
  // ruxsati bilan beriladi, lekin keyingi loginlarda kelmaydi; sub yagona stabil id.
  appleSub     String?  @unique @map("apple_sub")
  avatarUrl    String?  @map("avatar_url")
  language     String   @default("uz")
  isActive     Boolean  @default(true) @map("is_active")
  tokenVersion Int      @default(0) @map("token_version") // Sprint 6 P1 — logout'da increment
  // 1-haftalik Standart demo (trial) BIR MARTA berilganmi. Akkaunt o'chirib
  // qayta ochilsa ham qayta trial olinmasligi uchun (bir foydalanuvchi = 1 trial).
  trialUsed    Boolean  @default(false) @map("trial_used")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Parent relations
  childrenAsParent Child[] @relation("ParentChildren")

  // Child relations
  childRecord Child? @relation("ChildUser")

  // FCM tokens
  fcmTokens FcmToken[]

  // Messages
  sentMessages     VoiceMessage[] @relation("Sender")
  receivedMessages VoiceMessage[] @relation("Receiver")

  // Sprint 4.4: yangi modullar
  sentVideos             VideoMessage[]  @relation("VideoSender")
  receivedVideos         VideoMessage[]  @relation("VideoReceiver")
  photoRequestsAsParent  PhotoRequest[]  @relation("ParentPhotoRequests")
  listenSessionsAsParent ListenSession[] @relation("ParentListenSessions")

  // Sprint 5.2 — admin monetization
  payments Payment[]

  // Sprint 6 — P0 monetizatsiya
  subscriptions Subscription[]

  // Faol sessiyalar (login qilingan qurilmalar)
  sessions UserSession[]

  // 2-qurilma limit — 3-qurilma kirish so'rovlari
  sessionAccessRequests SessionAccessRequest[]

  schoolGuardians SchoolGuardian[]

  @@map("users")
}

enum UserRole {
  PARENT
  CHILD
}

// ============================================
// CHILDREN - Parent ↔ Child mapping
// ============================================
model Child {
  id                       String    @id @default(uuid())
  parentId                 String    @map("parent_id")
  childUserId              String?   @unique @map("child_user_id")
  name                     String
  // ⚠️ `age` SAQLANADI va O'CHIRILMAYDI — u kontent yosh-filtri, olimpiada
  // ro'yxati, admin push segmenti va avatar tanlashda ishlatiladi (hammasida
  // `?? 8` fallback bor). birthDate berilganda server age'ni UNDAN qayta
  // hisoblab shu ustunga ham yozadi (denormallashtirilgan kesh).
  age                      Int?
  // Tug'ilgan sana — ko'rsatish va yoshni hisoblash uchun haqiqat manbai.
  // @db.Date SHART: oddiy DateTime bo'lsa Toshkent (UTC+5) da sana bir kun
  // siljib ketadi (14.03 → 13.03). Eski bolalarda NULL — UI soxta 01.01
  // yasamasligi kerak, bo'sh ko'rsatadi.
  birthDate                DateTime? @map("birth_date") @db.Date
  gender                   String?
  region                   String?
  // SOS "Qo'ng'iroq" uchun bola telefon raqami (ota-ona kiritadi).
  phoneNumber              String?   @map("phone_number")
  photoPath                String?   @map("photo_path")
  familyCode               String    @unique @map("family_code")
  pairedAt                 DateTime? @map("paired_at")
  isConnected              Boolean   @default(false) @map("is_connected")
  lastSeenAt               DateTime? @map("last_seen_at")
  // "Aloqa uzildi" push spam'siz qilish uchun — oxirgi marta ota-onaga
  // uzilish ogohlantirishi yuborilgan vaqt. Bola qayta online bo'lganda
  // (heartbeat → lastSeenAt yangilanadi) null'ga qaytadi, keyingi uzilishda
  // yana BITTA push chiqsin (ConnectionMonitorService cron'i tekshiradi).
  connectionLostNotifiedAt DateTime? @map("connection_lost_notified_at")

  // Device info (Child App POST /location bilan birga yuboradi)
  batteryLevel   Int?     @map("battery_level")
  isCharging     Boolean? @map("is_charging")
  deviceModel    String?  @map("device_model")
  androidVersion String?  @map("android_version")
  appVersion     String?  @map("app_version")
  wifiName       String?  @map("wifi_name")

  // OS-ruxsat holatlari (Child App device-info heartbeat bilan yuboradi).
  // null = noma'lum (hali yuborilmagan). true = berilgan, false = rad etilgan.
  locationPermission     Boolean? @map("location_permission")
  notificationPermission Boolean? @map("notification_permission")
  backgroundAllowed      Boolean? @map("background_allowed")
  accessibilityEnabled   Boolean? @map("accessibility_enabled")
  // PACKAGE_USAGE_STATS ("Foydalanish ma'lumotlari") ruxsati — ekran vaqti /
  // ilova statistikasi shu ruxsatsiz yig'ilmaydi. Ota-onaga aniq sabab
  // ko'rsatish uchun ("ulanmagan" emas, "ruxsat yo'q").
  usagePermission        Boolean? @map("usage_permission")
  // iOS: Family Controls (Ekran vaqti) ruxsati — ilovalar cheklovi shusiz
  // ishlamaydi. Bola Sozlamalardan o'chirsa ota-onaga ogohlantirish ketadi.
  screenTimePermission   Boolean? @map("screen_time_permission")

  // Qurilma siyosati — "Notanish manbalardan ilovalar" (Play'dan boshqa
  // manbadan o'rnatilgan ilovalarni bloklash). Ota-ona yoqadi/o'chiradi.
  blockUnknownSources Boolean @default(false) @map("block_unknown_sources")
  // "Barcha ilovalarni bloklash" — ota-ona dashboard toggle'i. true = bola
  // qurilmasidagi barcha foydalanuvchi ilovalari bloklanadi.
  blockAllApps        Boolean @default(false) @map("block_all_apps")
  // "O'chirishni taqiqlash" — ota-ona toggle'i. true = bola Farzandim ilovasini
  // telefonidan o'chira olmaydi (Android Device Admin faollashadi, uninstall
  // bloklanadi). Bola app device-policy'dan o'qib admin'ni yoqadi/o'chiradi.
  blockUninstall      Boolean @default(false) @map("block_uninstall")

  // Xavfsiz internet filtri (ixtiyoriy, ota-ona yoqadi). Parvoz ichidagi
  // kontent allaqachon yoshga mos; bu esa tashqi web uchun ota-ona ixtiyoriy
  // yoqadigan xavfsiz filtr. Faqat Android'da enforce qilinadi (xavfsiz DNS).
  // iOS'da Screen Time orqali; bu yerda majburlanmaydi.
  webFilterEnabled     Boolean  @default(false) @map("web_filter_enabled")
  // Yoqilgan filtr kategoriyalari: ADULT | GAMBLING | SOCIAL. Bo'sh array =
  // hech biri (webFilterEnabled true bo'lsa ham). DTO'da class-validator bilan
  // tekshiriladi.
  blockedWebCategories String[] @default([]) @map("blocked_web_categories")

  // Bola qiziqishlari — onboarding'da tanlangan tag'lar (kitob, sport,
  // multfilm, kosmos, ...). Tavsiya tizimi (Books/Videos/Audiobooks/Konkurs)
  // shu tag'larga qarab kontent saralaydi. Admin paneldagi profilda ham
  // ko'rinadi. ID format: ContentCategory.slug bilan moslashadi (kitob →
  // book.school, multfilm → video.cartoon va h.k. interest_options.dart'da).
  interests String[] @default([])

  // Stop-detection state machine (incremental — har location yozuvida yangilanadi)
  // anchor = joriy klaster boshlangan nuqta; openStop = ochiq to'xtash (agar bor).
  stopAnchorLat Float?    @map("stop_anchor_lat")
  stopAnchorLng Float?    @map("stop_anchor_lng")
  stopAnchorAt  DateTime? @map("stop_anchor_at")
  openStopId    String?   @map("open_stop_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  parent        User           @relation("ParentChildren", fields: [parentId], references: [id], onDelete: Cascade)
  childUser     User?          @relation("ChildUser", fields: [childUserId], references: [id], onDelete: SetNull)
  locations     Location[]
  locationStops LocationStop[]
  schedules     Schedule[]
  routines      Routine[]
  geoZones      GeoZone[]
  geoZoneEvents GeoZoneEvent[]

  // Sprint 4.4: yangi modullar
  notifications          Notification[]
  feedback               Feedback[]
  profile                ChildProfile?
  xpEvents               XpEvent[]
  photoRequests          PhotoRequest[]
  listenSessions         ListenSession[]
  sosAlerts              SosAlert[]
  installedApps          InstalledApp[]
  appUsages              AppUsage[]
  stepDays               ChildStepDaily[]
  appLimits              AppLimit[]
  appPermissions         AppPermissionPolicy[]
  pairRequests           ChildPairRequest[]
  unlockRequests         UnlockRequest[]
  categoryBlocks         CategoryBlock[]
  notificationPreference NotificationPreference?
  aiMessages             AiMessage[]
  learningProfile        LearningProfile?
  learningAttempts       LearningAttempt[]
  learningReports        LearningReportDispatch[]
  kelajakSessions        KelajakSession[]
  schoolStudents         SchoolStudent[]

  // Sprint 5.4 — admin Olympiad attempts
  olympiadAttempts OlympiadAttempt[]

  // Videolar: ko'rish tarixi + yoqtirilgan (bola ilovasi feed header'i)
  videoViews     ChildVideoView[]
  videoFavorites ChildVideoFavorite[]

  @@index([parentId])
  @@index([familyCode])
  @@map("children")
}

// ============================================
// LOCATIONS - History
// ============================================
model Location {
  id           String    @id @default(uuid())
  childId      String    @map("child_id")
  latitude     Float
  longitude    Float
  accuracy     Float?
  speed        Float?
  batteryLevel Int?      @map("battery_level")
  isCharging   Boolean?  @map("is_charging")
  createdAt    DateTime  @default(now()) @map("created_at")
  // Kliyent GPS fix vaqti — offline flush'da createdAt (server vaqti)
  // noto'g'ri bo'ladi, tarix shu ustun bo'yicha filtrlanadi/saralanadi.
  capturedAt   DateTime? @map("captured_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt(sort: Desc)])
  @@index([childId, capturedAt(sort: Desc)])
  @@map("locations")
}

// ============================================
// LOCATION STOPS - to'xtagan joylar (xaritada marker)
// ============================================
// Backend incremental stop-detection bola bir joyda ≥2.5 daqiqa turganda
// bitta yozuv yaratadi (markaz, kelgan/ketgan vaqt, davomiylik). Harakat
// nuqtalari bu yerga yozilmaydi — ular faqat `locations` (yupqa chiziq).
model LocationStop {
  id          String    @id @default(uuid())
  childId     String    @map("child_id")
  latitude    Float
  longitude   Float
  arrivedAt   DateTime  @map("arrived_at")
  leftAt      DateTime? @map("left_at") // null = hali shu yerda
  durationSec Int       @default(0) @map("duration_sec")
  pointCount  Int       @default(1) @map("point_count")
  createdAt   DateTime  @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, arrivedAt(sort: Desc)])
  @@map("location_stops")
}

// ============================================
// VOICE MESSAGES
// ============================================
model VoiceMessage {
  id              String   @id @default(uuid())
  senderId        String   @map("sender_id")
  receiverId      String   @map("receiver_id")
  // Audio xabar fayl yo'li. Text xabarda bo'sh bo'lishi mumkin.
  storagePath     String?  @map("storage_path")
  durationSeconds Int?     @map("duration_seconds")
  // Text xabar matni. Audio xabarda null bo'ladi.
  text            String?  @db.Text
  // Media xabar (Telegram-style chat: rasm / hujjat). Fayl MinIO `chat`
  // bucket'da, `mediaKey` proxy orqali ko'rsatiladi. mediaType: 'image' | 'file'.
  mediaKey        String?  @map("media_key")
  mediaType       String?  @map("media_type")
  mimeType        String?  @map("mime_type")
  fileName        String?  @map("file_name")
  fileSize        Int?     @map("file_size")
  isRead          Boolean  @default(false) @map("is_read")
  createdAt       DateTime @default(now()) @map("created_at")

  sender   User @relation("Sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead])
  @@index([senderId])
  @@map("voice_messages")
}

// ============================================
// SCHEDULES - App restrictions
// ============================================
model Schedule {
  id         String         @id @default(uuid())
  childId    String         @map("child_id")
  name       String
  startTime  String         @map("start_time") // "HH:MM"
  endTime    String         @map("end_time")
  daysOfWeek Int[]          @map("days_of_week") // [1,2,3,4,5]
  action     ScheduleAction
  isActive   Boolean        @default(true) @map("is_active")
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId])
  @@map("schedules")
}

enum ScheduleAction {
  BLOCK
  ALLOW
}

// ============================================
// ROUTINES - Bola kun rejasi (Uxlash/Maktab/Sport...)
// Child Dashboard'da ko'rsatish uchun, enforcement YO'Q.
// Cheklash (BLOCK/ALLOW) uchun Schedule modeli ishlatiladi.
// ============================================
model Routine {
  id          String      @id @default(uuid())
  childId     String      @map("child_id")
  title       String // "Uxlash vaqti", "Maktab"
  type        RoutineType
  startHour   Int         @map("start_hour") // 0-23
  startMinute Int         @map("start_minute") // 0-59
  endHour     Int         @map("end_hour")
  endMinute   Int         @map("end_minute")
  weekdays    Int[] // ISO 8601 [1=Mon...7=Sun]
  isActive    Boolean     @default(true) @map("is_active")
  blockedApps String[]    @default([]) @map("blocked_apps") // "Ilova cheklovlar" — oyna ichida bloklanadigan paketlar
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, isActive])
  @@map("routines")
}

enum RoutineType {
  SLEEP
  SCHOOL
  HOMEWORK
  SPORT
  OTHER
}

// ============================================
// GEO ZONES
// ============================================
model GeoZone {
  id           String   @id @default(uuid())
  childId      String   @map("child_id")
  name         String
  centerLat    Float    @map("center_lat")
  centerLng    Float    @map("center_lng")
  radiusMeters Int      @map("radius_meters")
  alertOnEnter Boolean  @default(false) @map("alert_on_enter")
  alertOnExit  Boolean  @default(false) @map("alert_on_exit")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")

  child  Child          @relation(fields: [childId], references: [id], onDelete: Cascade)
  events GeoZoneEvent[]

  @@index([childId])
  @@map("geo_zones")
}

// --- Geo-zona kirish/chiqish hodisalari tarixi (Sprint 6 — P2) ---
model GeoZoneEvent {
  id        String   @id @default(uuid())
  zoneId    String   @map("zone_id")
  childId   String   @map("child_id")
  type      String // enter | exit
  latitude  Float
  longitude Float
  createdAt DateTime @default(now()) @map("created_at")

  zone  GeoZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  child Child   @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt(sort: Desc)])
  @@index([zoneId])
  @@map("geo_zone_events")
}

// ============================================
// FCM TOKENS
// ============================================
model FcmToken {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  token      String   @unique
  deviceType String?  @map("device_type") // 'android' | 'ios'
  deviceId   String?  @map("device_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("fcm_tokens")
}

// ============================================
// AUDIT LOGS
// ============================================
model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  resourceType String?  @map("resource_type")
  resourceId   String?  @map("resource_id")
  data         Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

// ============================================
// SPRINT 4.4 MODULLARI
// ============================================

// --- Video messages (voice-messages bilan o'xshash) ---
model VideoMessage {
  id              String   @id @default(uuid())
  senderId        String   @map("sender_id")
  receiverId      String   @map("receiver_id")
  storagePath     String   @map("storage_path")
  thumbnailPath   String?  @map("thumbnail_path")
  durationSeconds Int?     @map("duration_seconds")
  isRead          Boolean  @default(false) @map("is_read")
  createdAt       DateTime @default(now()) @map("created_at")

  sender   User @relation("VideoSender", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("VideoReceiver", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([receiverId, isRead])
  @@index([senderId])
  @@map("video_messages")
}

// --- Notifications ---
model Notification {
  id                  String           @id @default(uuid())
  childId             String           @map("child_id")
  type                NotificationType
  title               String
  body                String
  data                Json?
  isRead              Boolean          @default(false) @map("is_read")
  // Sprint 6 P2 — admin broadcast bog'lanishi (open/click tracking)
  adminNotificationId String?          @map("admin_notification_id")
  clickedAt           DateTime?        @map("clicked_at")
  createdAt           DateTime         @default(now()) @map("created_at")

  child             Child              @relation(fields: [childId], references: [id], onDelete: Cascade)
  adminNotification AdminNotification? @relation(fields: [adminNotificationId], references: [id], onDelete: SetNull)

  @@index([childId, isRead])
  @@index([childId, createdAt(sort: Desc)])
  @@index([adminNotificationId])
  @@map("notifications")
}

enum NotificationType {
  ACHIEVEMENT
  CONTEST
  SCHEDULE
  PARENT_REQUEST
  VOICE
  GEO_ZONE
  SYSTEM
  // Bola qurilmasi 10+ daqiqa heartbeat yubormadi (ilova o'chirilgan,
  // internet uzilgan yoki telefon faol emas). Ota-onaga bir marta push.
  CONNECTION_LOST
  // Bola bloklangan ilova/vaqt uchun qo'shimcha vaqt so'rayapti (child→parent).
  UNLOCK_REQUEST
  // Ota-ona unlock so'roviga qaror berdi: ruxsat berdi yoki rad etdi (parent→child).
  UNLOCK_DECISION
  // Bola telefonida muhim ruxsat (joylashuv/bildirishnoma/fon/maxsus
  // imkoniyatlar) granted→denied bo'ldi — ota-onaga holat ogohlantirishi.
  PERMISSION_CHANGED
  // Rejalashtirilgan ijobiy eslatmalar (bolaga) — dars/test, sport/sog'lom,
  // yangi kontent. NotificationPreference + tinch soatlar bilan boshqariladi.
  STUDY_NUDGE
  HEALTH_NUDGE
  CONTENT_REMINDER
  // Growth: ota-onaga haftalik o'qish hisoboti (faqat ota-ona ko'radi).
  LEARNING_REPORT
}

// ============================================
// AI COMPANION — Faro AI hamroh suhbati (#64/#65/#69/#70)
// ============================================
//
// Bola Faro bilan yozadi. Har xabar (bola + AI javobi) saqlanadi. `flagged`
// — xavfsizlik filtri ishlaganda (xavfli/nojo'ya mavzu) true; ota-ona
// suhbatni ko'radi va flagged xabarlar ajratib ko'rsatiladi. Shaxsiy
// ma'lumot to'planmaydi (system prompt so'ramaydi).
model AiMessage {
  id        String   @id @default(uuid())
  childId   String   @map("child_id")
  // 'user' (bola) | 'assistant' (Faro)
  role      String
  text      String
  // Xavfsizlik filtri ishladimi (xavfli kiruvchi yoki chiquvchi matn).
  flagged   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, createdAt])
  @@map("ai_messages")
}

// ============================================
// NOTIFICATION PREFERENCE — eslatma sozlamalari (#66/#67/#77)
// ============================================
//
// Har bola uchun bitta yozuv. Ota-ona (yoki bola) eslatma turlarini yoqadi/
// o'chiradi va tinch soatlarni (tun) belgilaydi. NudgeService cron shu
// sozlamaga va `last*NudgeAt` (kuniga bir marta — spam yo'q) ga qarab push
// yuboradi.
model NotificationPreference {
  id                    String    @id @default(uuid())
  childId               String    @unique @map("child_id")
  studyNudge            Boolean   @default(true) @map("study_nudge")
  healthNudge           Boolean   @default(true) @map("health_nudge")
  contentReminder       Boolean   @default(true) @map("content_reminder")
  // Tinch soatlar "HH:MM" (mahalliy, Asia/Tashkent). null = cheklov yo'q.
  quietFrom             String?   @map("quiet_from")
  quietTo               String?   @map("quiet_to")
  // Oxirgi yuborilgan vaqt — kuniga/haftada bir marta kafolati uchun.
  lastStudyNudgeAt      DateTime? @map("last_study_nudge_at")
  lastHealthNudgeAt     DateTime? @map("last_health_nudge_at")
  lastContentReminderAt DateTime? @map("last_content_reminder_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ============================================
// UNLOCK REQUESTS — bola "qo'shimcha vaqt" so'rovi
// ============================================
//
// Oqim: bola bloklangan ilova/ekran-vaqt uchun so'rov yuboradi (PENDING,
// 15 daqiqada javob kelmasa EXPIRED) → ota-onaga push → ota-ona rad etadi
// (DENIED) yoki 5–60 daqiqa beradi (APPROVED, grantedMinutes). APPROVED
// bo'lsa `expiresAt` = qaror + grantedMinutes (ruxsat shu vaqtgacha amal
// qiladi). Bola limit hisobi shu grant'ni kunlik limitga qo'shadi.
model UnlockRequest {
  id               String    @id @default(uuid())
  childId          String    @map("child_id")
  // APP uchun qaysi ilova; SCREEN_TIME uchun null (umumiy ekran vaqti).
  packageName      String?   @map("package_name")
  // 'APP' | 'SCREEN_TIME'
  kind             String
  // 'PENDING' | 'APPROVED' | 'DENIED' | 'EXPIRED'
  status           String    @default("PENDING")
  // Bola so'ragan qo'shimcha daqiqalar (5..60) — ota-onaga ko'rsatiladi va
  // tasdiqlashda default sifatida ishlatiladi ("o'shancha miqdorda beriladi").
  requestedMinutes Int?      @map("requested_minutes")
  // Bola yozgan sabab (ixtiyoriy) — ota-ona qaror berishda o'qiydi.
  reason           String?
  // Ota-ona bergan qo'shimcha daqiqalar (APPROVED bo'lsa 5..60).
  grantedMinutes   Int?      @map("granted_minutes")
  requestedAt      DateTime  @default(now()) @map("requested_at")
  decidedAt        DateTime? @map("decided_at")
  // PENDING: so'rov javob kutish muddati (now+15min). APPROVED: ruxsat shu
  // vaqtgacha amal qiladi (qaror + grantedMinutes). Shu o'tgach yana bloklanadi.
  expiresAt        DateTime  @map("expires_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, status])
  @@index([status, expiresAt])
  @@map("unlock_requests")
}

// ============================================
// CATEGORY BLOCK — ota-ona butun kategoriyani bloklaydi (#14)
// ============================================
//
// Ota-ona "Ijtimoiy tarmoqlar" kabi kategoriyani bloklasa, shu yozuv
// yaratiladi. Bola limit ro'yxati (app-limits.list) shu kategoriyadagi
// barcha o'rnatilgan ilovalarni DINAMIK ravishda blok sifatida qaytaradi
