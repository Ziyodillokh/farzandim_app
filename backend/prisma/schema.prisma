// --- Articles (foydali maqolalar / bilimlar — #48) ---
// Video/audio/kitobga o'xshash yoshga mos kontent: admin markdown maqola
// yuklaydi, bola o'qiydi. Yosh (ageFrom..ageTo) + status(approved) bo'yicha
// consumer endpoint filtrlaydi (videos/books patterni).
model Article {
  id        String   @id @default(uuid())
  title     String
  // Markdown matn (asosiy tana).
  body      String
  // Muqova rasm MinIO storage key (media proxy 'cover' orqali beriladi).
  coverPath String?  @map("cover_path")
  ageFrom   Int      @default(0) @map("age_from")
  ageTo     Int      @default(18) @map("age_to")
  category  String?
  status    String   @default("approved") // pending | approved | rejected | hidden
  views     Int      @default(0)
  likes     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([category])
  @@map("articles")
}

// ============================================
// ADMIN PANEL — Konkurslar / Olimpiada (Sprint 5.4)
// Konsept v2 markaziy g'oyasi. Admin yaratadi → bola Child App'da ishlaydi
// → Attempt jadvalida saqlanadi. Hozircha admin tomonida full lifecycle
// (draft/published) va statistikalar (participants, leaderboard).
// ============================================
model Olympiad {
  id                 String   @id @default(uuid())
  title              String
  description        String?
  // Banner rasmi (ixtiyoriy) — MinIO `olympiad` bucket kaliti. Bola
  // dashboard'idagi test karuseli banneri. Proxy: GET /olympiad-images/:key.
  coverKey           String?  @map("cover_key")
  subject            String // Matematika, Ona tili, Ingliz, Fizika, Kimyo, IT, Aralash
  ageFrom            Int      @map("age_from")
  ageTo              Int      @map("age_to")
  type               String   @default("test") // test | creative | mixed
  difficulty         String   @default("o'rta") // oson | o'rta | qiyin
  startTime          DateTime @map("start_time")
  endTime            DateTime @map("end_time")
  durationMin        Int      @default(30) @map("duration_min")
  maxAttempts        Int      @default(1) @map("max_attempts")
  xpReward           Int      @default(50) @map("xp_reward")
  // Testni ko'rish uchun KERAKLI eng past tarif (video/audiobook/book bilan
  // bir xil rank tizimi): free=0 < standard < premium < vip. `free` = hamma
  // ko'radi ("Barchasi"). consumer-olympiads shu bo'yicha filtrlaydi.
  planRequired       String   @default("free") @map("plan_required")
  shuffleQuestions   Boolean  @default(true) @map("shuffle_questions")
  shuffleAnswers     Boolean  @default(true) @map("shuffle_answers")
  hideResults        Boolean  @default(false) @map("hide_results")
  allowBack          Boolean  @default(true) @map("allow_back")
  certificateEnabled Boolean  @default(true) @map("certificate_enabled")
  status             String   @default("draft") // draft | published | archived
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  questions OlympiadQuestion[]
  attempts  OlympiadAttempt[]

  @@index([status])
  @@index([subject])
  @@index([startTime])
  @@index([planRequired])
  @@map("olympiads")
}

model OlympiadQuestion {
  id           String   @id @default(uuid())
  olympiadId   String   @map("olympiad_id")
  text         String
  options      String[]
  // Har variant uchun IXTIYORIY rasm (MinIO `olympiad` bucket kaliti) —
  // `options` bilan bir xil uzunlikda, bo'sh ("") = faqat matn. Matematik
  // formula/diagramma javoblar uchun. Proxy: GET /olympiad-images/:key.
  optionImages String[] @default([]) @map("option_images")
  correctIndex Int      @map("correct_index")
  points       Int      @default(10)
  // Savol rasmi (ixtiyoriy) — MinIO `olympiad` bucket kaliti. Matematik
  // funksiyalar kabi yozib bo'lmaydigan savollar uchun. Proxy:
  // GET /olympiad-images/:key (@Public, capability URL).
  imageKey     String?  @map("image_key")
  orderIdx     Int      @default(0) @map("order_idx")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  olympiad Olympiad @relation(fields: [olympiadId], references: [id], onDelete: Cascade)

  @@index([olympiadId, orderIdx])
  @@map("olympiad_questions")
}

model OlympiadAttempt {
  id             String    @id @default(uuid())
  olympiadId     String    @map("olympiad_id")
  childId        String    @map("child_id")
  startedAt      DateTime  @default(now()) @map("started_at")
  finishedAt     DateTime? @map("finished_at")
  status         String    @default("in_progress") // in_progress | finished | abandoned
  score          Int       @default(0)
  totalPoints    Int       @default(0) @map("total_points")
  correctAnswers Int       @default(0) @map("correct_answers")
  questionsTotal Int       @default(0) @map("questions_total")
  timeSec        Int       @default(0) @map("time_sec")
  answers        Json      @default("[]") // [{ questionId, selectedIndex, isCorrect }]

  olympiad Olympiad @relation(fields: [olympiadId], references: [id], onDelete: Cascade)
  child    Child    @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([olympiadId, childId])
  @@index([olympiadId, score])
  @@index([childId])
  @@map("olympiad_attempts")
}

// ============================================
// ADMIN PANEL — Bildirishnoma broadcast (Sprint 5.3)
// Per-child `Notification` modelidan farqli: bu admin tomonidan auditoriyaga
// yuborilgan bulk push. Hozircha real FCM fan-out qilinmaydi — yozuv va
// sintetik metric (delivered/opened/clicked) saqlanadi.
// ============================================
model AdminNotification {
  id             String    @id @default(uuid())
  title          String
  message        String
  targetType     String    @map("target_type") // all | parents | children | premium | age_group
  filters        Json      @default("{}")
  imageUrl       String?   @map("image_url")
  deepLink       String?   @map("deep_link")
  status         String    @default("sent") // sent | scheduled | queued | sending | failed
  scheduledAt    DateTime? @map("scheduled_at")
  sentAt         DateTime? @map("sent_at")
  deliveredCount Int       @default(0) @map("delivered_count")
  openedCount    Int       @default(0) @map("opened_count")
  clickedCount   Int       @default(0) @map("clicked_count")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  createdById    String?   @map("created_by_id")

  notifications Notification[]

  @@index([status])
  @@index([targetType])
  @@index([createdAt])
  @@map("admin_notifications")
}

// ============================================
// ADMIN PANEL — Monetization (Sprint 5.2)
// Tariflar (Plan), Promokodlar (Promocode), To'lov tarixi (Payment).
// User'lar bilan Telegram-bind FK orqali bog'lanadi (consumer side).
// ============================================
model Plan {
  id              String   @id @default(uuid())
  slug            String   @unique
  name            String
  description     String?
  priceUzs        Int      @default(0) @map("price_uzs")
  period          String   @default("monthly") // free | monthly | yearly
  entitlementTier String   @default("standard") @map("entitlement_tier") // free | standard | premium
  badge           String?
  features        String[] @default([])
  isActive        Boolean  @default(true) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  promocodes    Promocode[]
  payments      Payment[]
  subscriptions Subscription[]

  @@map("plans")
}

model Promocode {
  id          String    @id @default(uuid())
  code        String    @unique
  discountPct Int       @map("discount_pct")
  usageLimit  Int       @default(0) @map("usage_limit")
  usedCount   Int       @default(0) @map("used_count")
  expiresAt   DateTime? @map("expires_at")
  status      String    @default("active") // active | inactive | archived
  planId      String?   @map("plan_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([planId])
  @@map("promocodes")
}

model Payment {
  id             String    @id @default(uuid())
  userId         String?   @map("user_id")
  planId         String?   @map("plan_id")
  planName       String?   @map("plan_name") // snapshot — Plan o'chirilsa ham qoladi
  subscriptionId String?   @map("subscription_id") // Sprint 6 — to'lov aktivlashtirgan obuna
  amount         Int // so'm (UZS)
  method         String // click | payme | uzum_bank | visa | mastercard
  status         String    @default("success") // success | pending | failed | refunded | cancelled
  externalId     String?   @map("external_id") // provayder tranzaksiya ID'si
  idempotencyKey String?   @unique @map("idempotency_key") // takroriy checkout/callback'ni bloklaydi
  providerData   Json?     @map("provider_data") // provayder callback'idan kelgan xom payload
  promocodeId    String?   @map("promocode_id")
  notes          String?
  paidAt         DateTime? @map("paid_at") // muvaffaqiyatli to'lov vaqti
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  plan         Plan?         @relation(fields: [planId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([planId])
  @@index([subscriptionId])
  @@index([method])
  @@index([createdAt])
  @@map("payments")
}

// ============================================
// SUBSCRIPTION (Sprint 6 — P0 monetizatsiya)
// Foydalanuvchining aktiv obunasi. To'lov success bo'lganda yaratiladi yoki
// uzaytiriladi. consumer-content plan-gating shu modeldan o'qiydi —
// avvalgi Payment-scan approximation o'rniga.
// ============================================
model Subscription {
  id                   String             @id @default(uuid())
  userId               String             @map("user_id")
  planId               String?            @map("plan_id")
  status               SubscriptionStatus @default(PENDING)
  startedAt            DateTime?          @map("started_at")
  expiresAt            DateTime?          @map("expires_at")
  autoRenew            Boolean            @default(false) @map("auto_renew")
  cancelledAt          DateTime?          @map("cancelled_at")
  // 1-haftalik Standart demo (trial) — pullik obunadan farqlash uchun. To'lov
  // qilinganda `false`ga o'tadi (activateSubscriptionTx). Cron shu bo'yicha
  // trial tugashini kuzatadi.
  isTrial              Boolean            @default(false) @map("is_trial")
  trialReminderSentAt  DateTime?          @map("trial_reminder_sent_at")
  trialEndedNotifiedAt DateTime?          @map("trial_ended_notified_at")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan     Plan?     @relation(fields: [planId], references: [id], onDelete: SetNull)
  payments Payment[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@index([isTrial, expiresAt])
  @@map("subscriptions")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  EXPIRED
  CANCELLED
}

// ============================================
// ADMIN PANEL — Moderator (Sprint 5.1)
// Alohida auth flow (email + password + JWT audience "admin-panel"),
// hech qanday Telegram bog'lanishi yo'q. Permission kalitlari
// admin_panel Flutter Web tomonidagi staff_permissions.dart bilan mos.
// ============================================
model ModeratorAuditLog {
  id           String   @id @default(uuid())
  moderatorId  String?  @map("moderator_id") // null = anonymous (failed login)
  email        String? // captured at action time (immutable)
  action       String // "auth.login.success", "video.approve", ...
  resourceType String?  @map("resource_type") // "video" | "moderator" | ...
  resourceId   String?  @map("resource_id") // target id
  status       String   @default("success") // success | failure
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  details      Json? // free-form (payload, error, ...)
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([moderatorId, createdAt(sort: Desc)])
  @@index([action, createdAt(sort: Desc)])
  @@index([resourceType, resourceId])
  @@map("moderator_audit_logs")
}

model Moderator {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  phone                String?
  passwordHash         String    @map("password_hash")
  moderatorRoleKey     String    @map("moderator_role_key") // super_admin | finance | content_maker | support | custom
  permissions          String[]  @default([])
  status               String    @default("active") // active | blocked
  tokenVersion         Int       @default(0) @map("token_version") // Sprint 6 P1 — logout'da increment
  lastActivityAt       DateTime? @map("last_activity_at")
  // Sprint 5.x — TOTP 2FA (Google Authenticator, Authy, ...)
  twoFactorEnabled     Boolean   @default(false) @map("two_factor_enabled")
  twoFactorSecret      String?   @map("two_factor_secret") // base32 TOTP secret
  twoFactorBackupCodes String[]  @default([]) @map("two_factor_backup_codes") // bcrypt hashed, single-use
  twoFactorEnabledAt   DateTime? @map("two_factor_enabled_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")

  @@index([moderatorRoleKey])
  @@index([status])
  @@map("moderators")
}

// ============================================
// OTP (Phone verification)
// ============================================
model OtpCode {
  id         String    @id @default(uuid())
  // phone YOKI email — bittasi to'ladi (telefon SMS OTP yoki email OTP).
  phone      String?
  email      String?
  code       String
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at")
  verifiedAt DateTime? @map("verified_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([phone, createdAt(sort: Desc)])
  @@index([email, createdAt(sort: Desc)])
  @@map("otp_codes")
}

// ============================================
// USER SESSIONS — "Faol sessiyalar" (login qilingan qurilmalar)
// ============================================
// Har login (telegram/email/phone) yangi sessiya yaratadi. Refresh
// token rotation `jti` orqali bog'lanadi. Foydalanuvchi boshqa
// qurilmalarni uzoqdan tugata oladi (revokedAt set → refresh rad etiladi).
model UserSession {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  // Refresh token JTI (rotation'da yangilanadi) — reuse detection.
  jti         String    @unique
  deviceModel String?   @map("device_model") // "Redmi Note 12S", "iPhone 14 Pro Max"
  platform    String? // "android" | "ios" | "web"
  ipAddress   String?   @map("ip_address")
  city        String?
  country     String?
  userAgent   String?   @map("user_agent")
  createdAt   DateTime  @default(now()) @map("created_at")
  lastSeenAt  DateTime  @default(now()) @map("last_seen_at")
  revokedAt   DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("user_sessions")
}

// ============================================
// ADMIN SECURITY SETTINGS — singleton (IP allowlist va h.k.)
// ============================================
// Bitta qator (id = "singleton"). Admin panel xavfsizlik siyosati: IP
// allowlist (yoqilgan bo'lsa faqat shu IP'lardan admin kira oladi).
model AdminSecuritySettings {
  id                 String   @id @default("singleton")
  ipAllowlistEnabled Boolean  @default(false) @map("ip_allowlist_enabled")
  ipAllowlist        String[] @default([]) @map("ip_allowlist")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("admin_security_settings")
}

// ─────────────────────────────────────────────────────────────────
// SUPPORT CHAT — Telegram ko'prigi (ota-ona ⇄ operator guruhda)
// ─────────────────────────────────────────────────────────────────

// Qo'llab-quvvatlash chati xabari. FK ATAYIN yo'q (userId oddiy string) —
// User modeliga tegmaslik uchun; userId indekslangan.
model SupportMessage {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  sender         String // 'user' | 'operator'
  text           String?
  // Server tomonidagi avto-javob ("tez orada javob beramiz") — klient buni
  // o'z tilida ko'rsatadi (matn emas, bayroq saqlanadi).
  isAutoAck      Boolean  @default(false) @map("is_auto_ack")
  attachmentKey  String?  @map("attachment_key")
  attachmentType String?  @map("attachment_type") // image | video | document
  fileName       String?  @map("file_name")
  fileSize       Int?     @map("file_size")
  mimeType       String?  @map("mime_type")
  // Guruhga yuborilgan TG xabar id'si — operator swipe-reply qilsa routing.
  tgMessageId    Int?     @map("tg_message_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@index([tgMessageId])
  @@map("support_messages")
}

// "✍️ Javob berish" bosilganda yuborilgan ForceReply prompt → qaysi user'ga.
model SupportTgPrompt {
  promptMessageId Int      @id @map("prompt_message_id")
  userId          String   @map("user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  @@map("support_tg_prompts")
}

// Telegram getUpdates offset'i — restart'da yo'qolmasin.
model SupportTgState {
  id     Int @id @default(1)
  offset Int @default(0)

  @@map("support_tg_state")
}

// Do'kondagi JONLI ilova versiyasi — cron kuniga bir marta App Store va
// Play'dan o'qib yozadi.
//
// ⚠️ NEGA BAZADA, FAYLDA EMAS: deploy `rsync --delete` bilan repo'dagi
// backend/ ni serverga ko'chiradi — cron config/app-versions.json ga
// yozsa, keyingi deploy o'chirib tashlaydi. Baza deploy'dan omon qoladi.
//
// app-versions.json ASOS bo'lib qoladi (havolalar, minSupported,
// releaseNotes, isForceUpdate); bu jadval faqat `latest` ni ustidan
// yozadi va faqat ISHONCHLI qiymat olinganda.
model StoreVersion {
  id        String   @id @default(uuid())
  app       String // parent | child
  platform  String // android | ios
  latest    String // "1.0.4"
  source    String // itunes | play
  checkedAt DateTime @default(now()) @updatedAt @map("checked_at")

  @@unique([app, platform])
  @@map("store_versions")
}

// ─────────────────────────────────────────────────────────────────────
// Growth — Daily Learning (kunlik fan testlari)
// ─────────────────────────────────────────────────────────────────────

enum LearningSubject {
  MATH
  ENGLISH
  NATIVE
  HISTORY
  BIOLOGY
  GEOGRAPHY
  PHYSICS
  CHEMISTRY
  INFORMATICS
  RUSSIAN
}

enum LearningQuestionStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum LearningAttemptStatus {
  IN_PROGRESS
  COMPLETED
  // Boshqa kunda yakunlanmay qolgan urinish (yangi kun boshlanganda).
  ABANDONED
}

/// Bolaning o'quv profili — sinf va kunlik testlar uchun fanlar.
model LearningProfile {
  childId   String            @id @map("child_id")
  grade     Int
  subjects  LearningSubject[]
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@map("learning_profiles")
}

/// Savollar banki. Matnlar `{uz, ru, en}` JSON; `externalId` — import
/// (masalan "math-01") uchun barqaror kalit.
model LearningQuestion {
  id          String                 @id @default(uuid())
  externalId  String?                @unique @map("external_id")
  subject     LearningSubject
  difficulty  Int
  minGrade    Int                    @map("min_grade")
  maxGrade    Int                    @map("max_grade")
  topic       Json
  prompt      Json
  options     Json
  answerIndex Int                    @map("answer_index")
  explanation Json
  status      LearningQuestionStatus @default(ACTIVE)
  createdBy   String?                @map("created_by")
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  answers LearningAnswer[]

  @@index([subject, status])
  @@map("learning_questions")
}

/// Bitta test urinishi (fan bo'yicha). `day` — Toshkent kuni (YYYY-MM-DD);
/// `isDaily` — fan bo'yicha kunning birinchi urinishi (DON shunga beriladi).
model LearningAttempt {
  id            String                @id @default(uuid())
  childId       String                @map("child_id")
  subject       LearningSubject
  day           String
  isDaily       Boolean               @map("is_daily")
  status        LearningAttemptStatus @default(IN_PROGRESS)
  questionIds   String[]              @map("question_ids")
  topic         Json?
  correct       Int                   @default(0)
  total         Int
  xpEarned      Int                   @default(0) @map("xp_earned")
  donEarned     Int                   @default(0) @map("don_earned")
  startedAt     DateTime              @default(now()) @map("started_at")
  completedAt   DateTime?             @map("completed_at")
  /// Yakunlash paytida bola bog'langan maktab sinfi (snapshot). Maktab hisobotlari
  /// shu bo'yicha: o'quvchini ko'chirish / uzish tarixni o'zgartirmaydi, bog'lashdan
  /// oldingi faollik maktabga ko'rinmaydi.
  schoolClassId String?               @map("school_class_id")

  child   Child            @relation(fields: [childId], references: [id], onDelete: Cascade)
  answers LearningAnswer[]

  @@index([childId, day])
  @@index([childId, status, completedAt(sort: Desc)])
  @@index([day, status])
  @@index([schoolClassId, day])
  @@map("learning_attempts")
}

/// Savolga javob — bitta savolga bir marta (o'zgartirib bo'lmaydi).
model LearningAnswer {
  id            String   @id @default(uuid())
  attemptId     String   @map("attempt_id")
  questionId    String   @map("question_id")
  position      Int
  selectedIndex Int      @map("selected_index")
  isCorrect     Boolean  @map("is_correct")
  answeredAt    DateTime @default(now()) @map("answered_at")

  attempt  LearningAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question LearningQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([questionId])
  @@map("learning_answers")
}

/// Haftalik hisobot yuborilganligi (bola + hafta) — takror yuborilmaydi.
model LearningReportDispatch {
  id        String   @id @default(uuid())
  childId   String   @map("child_id")
  weekStart String   @map("week_start")
  sentAt    DateTime @default(now()) @map("sent_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@unique([childId, weekStart])
  @@map("learning_report_dispatches")
}

// ─────────────────────────────────────────────────────────────────────
// Parvoz Kelajak — o'z-o'zini baholash savollari (kasbiy qiziqishlar,
// o'qish, farovonlik, Career Lab). Kontrakt: docs/KELAJAK-REJA.md.
// ─────────────────────────────────────────────────────────────────────

enum KelajakSessionStatus {
  STARTED // yaratildi, hali javob yo'q
  IN_PROGRESS // kamida bitta javob
  COMPLETED
  ABANDONED // o'tgan kunda yakunlanmay qolgan
}

/// Kelajak savollar banki. Matn va variantlar `{uz, ru?, en?}` JSON;
/// `externalId` ("PARVOZ-Q001") — import uchun barqaror kalit.
model KelajakQuestion {
  id            String   @id @default(uuid())
  externalId    String   @unique @map("external_id")
  category      String // career_interest, learning, ...
  ageGroup      String   @map("age_group") // "7-9" | "10-12" | "13-15" | "16-18"
  text          Json // {uz, ru?, en?}
  answerType    String   @map("answer_type") // interest_4 | likert_5 | career_lab_5 | text | ...
  options       Json // [{value, label: {uz, ru?, en?}}], text uchun []
  scoring       Json? // JSON'dagi scoring obyekti, text uchun null
  reverse       Boolean  @default(false) // yuqori qiymat = tashvish
  required      Boolean  @default(true)
  followUp      String?  @map("follow_up")
  notes         String?
  reviewNote    String?  @map("review_note")
  sourceType    String   @map("source_type")
  sourceName    String   @map("source_name")
  sourceVersion String   @map("source_version")
  active        Boolean  @default(true)
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  answers KelajakAnswer[]

  @@index([ageGroup, active, category])
  @@map("kelajak_questions")
}

/// Bitta test sessiyasi (tur + Toshkent kuni). `questionIds` — tartib bilan
/// snapshot; `result` — yakunda faqat kodlar va ballar (matn emas).
model KelajakSession {
  id             String               @id @default(uuid())
  childId        String               @map("child_id")
  type           String // daily | career | wellbeing | learning | self | career_lab | voice
  ageGroup       String               @map("age_group") // boshlangandagi snapshot
  day            String // Toshkent kuni YYYY-MM-DD
  status         KelajakSessionStatus @default(STARTED)
  questionIds    String[]             @map("question_ids")
  total          Int
  result         Json?
  scoringVersion Int?                 @map("scoring_version")
  startedAt      DateTime             @default(now()) @map("started_at")
  completedAt    DateTime?            @map("completed_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")

  child   Child           @relation(fields: [childId], references: [id], onDelete: Cascade)
  answers KelajakAnswer[]

  @@index([childId, type, day])
  @@index([childId, status, completedAt(sort: Desc)])
  @@map("kelajak_sessions")
}

/// Savolga javob — sessiya ochiq ekan o'zgartirish mumkin. Ochiq matn
/// `SchoolCryptoService` bilan shifrlanadi.
model KelajakAnswer {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  questionId String   @map("question_id")
  position   Int
  value      Int? // shkala qiymati
  textEnc    String?  @map("text_enc") // ochiq javob (shifrlangan)
  answeredAt DateTime @default(now()) @map("answered_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  session  KelajakSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question KelajakQuestion @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([sessionId, questionId])
  @@index([questionId])
  @@map("kelajak_answers")
}

// ─────────────────────────────────────────────────────────────────────
// Parvoz School — maktab paneli (1-to'lqin: tuzilma, xodimlar, o'quvchilar,
// vasiylar, davomat). Har jadvalda `schoolId` — tenant izolyatsiyasi.
// Sana — Toshkent kuni ("YYYY-MM-DD"), vaqt — "HH:MM".
// ─────────────────────────────────────────────────────────────────────

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum SchoolStaffRole {
  DIRECTOR
  ADMIN
  HOMEROOM
  PSYCHOLOGIST
  DUTY
  TEACHER
}

enum SchoolGender {
  MALE
  FEMALE
}

enum SchoolDeviceOs {
  IOS
  ANDROID
  NONE
}

enum GuardianRelation {
  MOTHER
  FATHER
  GRANDPARENT
  OTHER
}

enum GuardianLinkStatus {
  NOT_INVITED
  INVITED
  LINKED
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  LEFT_EARLY
  EXCUSED
}

enum AttendanceSource {
  QR
  KIOSK
  MANUAL
  SYSTEM
}

enum AttendanceEventKind {
  IN
  OUT
}

enum EarlyExitStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ParentNoticeKind {
  ARRIVED
  LEFT
  ABSENT
  EARLY_EXIT
}

/// Maktab (tenant). `code` — panelga kirishda kiritiladigan kod.
model School {
  id               String       @id @default(uuid())
  code             String       @unique
  name             String
  shortName        String       @map("short_name")
  city             String       @default("")
  address          String       @default("")
  phone            String       @default("")
  /// data:image/... (≤ 350 KB) yoki null.
  logo             String?
  academicYear     String       @map("academic_year")
  lateAfterMinutes Int          @default(10) @map("late_after_minutes")
  /// [{ no, start, end }] — o'quv choraklari.
  quarters         Json         @default("[]")
  /// Kiosk QR kodlarini imzolash kaliti (har maktabga alohida).
  kioskSecret      String       @map("kiosk_secret")
  status           SchoolStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  shifts              SchoolShift[]
  holidays            SchoolHoliday[]
  classes             SchoolClass[]
  staff               SchoolStaff[]
  audit               SchoolAuditLog[]
  students            SchoolStudent[]
  guardians           SchoolGuardian[]
  attendance          SchoolAttendance[]
  events              SchoolAttendanceEvent[]
  earlyExits          SchoolEarlyExit[]
  parentNotices       SchoolParentNotice[]
  studentNotes        SchoolStudentNote[]
  staffSessions       SchoolStaffSession[]
  announcements       SchoolAnnouncement[]
  reminders           SchoolReminder[]
  paymentReminders    SchoolPaymentReminder[]
  verifications       SchoolVerificationRequest[]
  modePolicies        SchoolModePolicy[]
  modeExceptions      SchoolModeException[]
  emergency           SchoolEmergency?
  careQuestions       SchoolCareQuestion[]
  careSurveys         SchoolCareSurvey[]
  careResponses       SchoolCareResponse[]
  careRequests        SchoolCareRequest[]
  psychTests          SchoolPsychTest[]
  psychTemplateStates SchoolPsychTemplateState[]
  psychAssignments    SchoolPsychAssignment[]
  psychResults        SchoolPsychResult[]
  staffNotifications  SchoolStaffNotification[]
  learningAssignments SchoolLearningAssignment[]

  @@map("schools")
}

/// Smena: boshlanish / tugash, hafta kunlari va qo'ng'iroqlar jadvali.
model SchoolShift {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  name      String
  start     String
  end       String
  weekdays  Int[]
  /// [{ no, start, end, kind: LESSON | BREAK }]
  periods   Json     @default("[]")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes SchoolClass[]

  @@index([schoolId])
  @@map("school_shifts")
}

model SchoolHoliday {
  id       String @id @default(uuid())
  schoolId String @map("school_id")
  date     String
  name     String

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, date])
  @@map("school_holidays")
}

model SchoolClass {
  id              String   @id @default(uuid())
  schoolId        String   @map("school_id")
  grade           Int
  letter          String
  /// "7-A" — maktab ichida takrorlanmaydi.
  name            String
  shiftId         String   @map("shift_id")
  homeroomStaffId String?  @map("homeroom_staff_id")
  room            String   @default("")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  school   School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  shift    SchoolShift        @relation(fields: [shiftId], references: [id], onDelete: Restrict)
  homeroom SchoolStaff?       @relation("ClassHomeroom", fields: [homeroomStaffId], references: [id], onDelete: SetNull)
  staff    SchoolStaffClass[]
  students SchoolStudent[]

  @@unique([schoolId, name])
  @@index([schoolId, grade])
  @@map("school_classes")
}

/// Maktab xodimi. `username` + `passwordHash` bo'lsa — panelga kira oladi.
model SchoolStaff {
  id                 String          @id @default(uuid())
  schoolId           String          @map("school_id")
  fullName           String          @map("full_name")
  position           String          @default("")
  role               SchoolStaffRole
  phone              String          @default("")
  email              String          @default("")
  /// data:image/... (≤ 120 KB) yoki null.
  photo              String?
  portrait           String?
  active             Boolean         @default(true)
  username           String?
  passwordHash       String?         @map("password_hash")
  mustChangePassword Boolean         @default(false) @map("must_change_password")
  tokenVersion       Int             @default(0) @map("token_version")
  failedLogins       Int             @default(0) @map("failed_logins")
  lockedUntil        DateTime?       @map("locked_until")
  lastLoginAt        DateTime?       @map("last_login_at")
  totpSecret         String?         @map("totp_secret")
  totpEnabled        Boolean         @default(false) @map("totp_enabled")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  school     School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes    SchoolStaffClass[]
  homeroomOf SchoolClass[]        @relation("ClassHomeroom")
  sessions   SchoolStaffSession[]

  @@unique([schoolId, username])
  @@index([schoolId, role])
  @@map("school_staff")
}

/// Sinf doirasi (sinf rahbari / o'qituvchi).
model SchoolStaffClass {
  staffId String @map("staff_id")
  classId String @map("class_id")

  staff SchoolStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)
  class SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([staffId, classId])
  @@index([classId])
  @@map("school_staff_classes")
}

/// Panel sessiyasi — refresh token (faqat xeshi saqlanadi), rotatsiya bilan.
model SchoolStaffSession {
  id                String    @id @default(uuid())
  schoolId          String    @map("school_id")
  staffId           String    @map("staff_id")
  tokenHash         String    @unique @map("token_hash")
  /// Oldingi refresh sir xeshi — bir vaqtdagi (ikki tab) refresh poygasi
  /// o'g'irlik deb hisoblanmasligi uchun qisqa imtiyoz oynasida qabul qilinadi.
  previousTokenHash String?   @map("previous_token_hash")
  rotatedAt         DateTime? @map("rotated_at")
  userAgent         String?   @map("user_agent")
  ip                String?
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")

  school School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  staff  SchoolStaff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@map("school_staff_sessions")
}

/// Har o'zgarish — kim, nima, qachon, oldin / keyin.
model SchoolAuditLog {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  at        DateTime @default(now())
  actorId   String?  @map("actor_id")
  actorName String   @map("actor_name")
  module    String
  action    String
  entityId  String?  @map("entity_id")
  summary   String
  params    Json?
  before    Json?
  after     Json?
  ip        String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, at(sort: Desc)])
  @@index([schoolId, module, at(sort: Desc)])
  @@map("school_audit_logs")
}

model SchoolStudent {
  id          String         @id @default(uuid())
  schoolId    String         @map("school_id")
  classId     String?        @map("class_id")
  lastName    String         @map("last_name")
  firstName   String         @map("first_name")
  middleName  String         @default("") @map("middle_name")
  gender      SchoolGender
  birthDate   String         @map("birth_date")
  /// Telefoni (xodim belgilaydi; Parvoz bilan bog'langanda ham shu).
  device      SchoolDeviceOs @default(NONE)
  /// Kiosk / QR uchun qisqa kod ("P-4821").
  studentCode String         @map("student_code")
  enrolledAt  String         @map("enrolled_at")
  archived    Boolean        @default(false)
  archivedAt  DateTime?      @map("archived_at")
  /// Parvoz bola ilovasi (ota-ona bog'laganda).
  childId     String?        @unique @map("child_id")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  school     School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  class      SchoolClass?            @relation(fields: [classId], references: [id], onDelete: SetNull)
  child      Child?                  @relation(fields: [childId], references: [id], onDelete: SetNull)
  guardians  SchoolStudentGuardian[]
  attendance SchoolAttendance[]
  notes      SchoolStudentNote[]

  @@unique([schoolId, studentCode])
  @@index([schoolId, classId])
  @@map("school_students")
}

model SchoolGuardian {
  id              String             @id @default(uuid())
  schoolId        String             @map("school_id")
  fullName        String             @map("full_name")
  phone           String
  relation        GuardianRelation
  linkStatus      GuardianLinkStatus @default(NOT_INVITED) @map("link_status")
  inviteCode      String?            @unique @map("invite_code")
  inviteExpiresAt DateTime?          @map("invite_expires_at")
  linkedAt        DateTime?          @map("linked_at")
  /// Parvoz Parents foydalanuvchisi (taklif kodi kiritilganda).
  userId          String?            @map("user_id")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  school   School                  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user     User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  students SchoolStudentGuardian[]

  @@index([schoolId, phone])
  @@index([userId])
  @@map("school_guardians")
}

model SchoolStudentGuardian {
  studentId  String @map("student_id")
  guardianId String @map("guardian_id")

  student  SchoolStudent  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  guardian SchoolGuardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@id([studentId, guardianId])
  @@index([guardianId])
  @@map("school_student_guardians")
}

/// Xodim eslatmasi (auditga matn yozilmaydi).
model SchoolStudentNote {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  studentId String   @map("student_id")
  classId   String?  @map("class_id")
  at        DateTime @default(now())
  byStaffId String   @map("by_staff_id")
  text      String

  school  School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student SchoolStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, at(sort: Desc)])
  @@map("school_student_notes")
}

/// Kunlik davomat (o'quvchi + kun bo'yicha bitta yozuv).
model SchoolAttendance {
  id             String           @id @default(uuid())
  schoolId       String           @map("school_id")
  date           String
  studentId      String           @map("student_id")
  classId        String?          @map("class_id")
  status         AttendanceStatus
  inAt           String?          @map("in_at")
  outAt          String?          @map("out_at")
  source         AttendanceSource
  parentNotified Boolean          @default(false) @map("parent_notified")
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  school      School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  student     SchoolStudent                @relation(fields: [studentId], references: [id], onDelete: Cascade)
  corrections SchoolAttendanceCorrection[]

  @@unique([studentId, date])
  @@index([schoolId, date])
  @@map("school_attendance")
}

model SchoolAttendanceCorrection {
  id           String           @id @default(uuid())
  attendanceId String           @map("attendance_id")
  at           DateTime         @default(now())
  byStaffId    String           @map("by_staff_id")
  from         AttendanceStatus
  to           AttendanceStatus
  reason       String

  attendance SchoolAttendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)

  @@index([attendanceId])
  @@map("school_attendance_corrections")
}

/// Kirish / chiqish hodisasi (QR, kiosk, qo'lda).
model SchoolAttendanceEvent {
  id        String              @id @default(uuid())
  schoolId  String              @map("school_id")
  at        DateTime            @default(now())
  date      String
  studentId String              @map("student_id")
  classId   String?             @map("class_id")
  kind      AttendanceEventKind
  source    AttendanceSource
  late      Boolean             @default(false)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, date, at(sort: Desc)])
  @@index([studentId, date])
  @@map("school_attendance_events")
}

/// Erta ketish so'rovi (ota-ona yoki xodim kiritadi, xodim qaror qiladi).
model SchoolEarlyExit {
  id                String          @id @default(uuid())
  schoolId          String          @map("school_id")
  studentId         String          @map("student_id")
  classId           String?         @map("class_id")
  date              String
  time              String
  reason            String
  pickupBy          String          @map("pickup_by")
  status            EarlyExitStatus @default(PENDING)
  requestedAt       DateTime        @default(now()) @map("requested_at")
  requestedByUserId String?         @map("requested_by_user_id")
  decidedByStaffId  String?         @map("decided_by_staff_id")
  decidedAt         DateTime?       @map("decided_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, date])
  @@index([schoolId, status])
  @@map("school_early_exits")
}

/// Ota-onaga yuborilgan davomat xabari (keldi / ketdi / kelmadi / erta ketdi).
model SchoolParentNotice {
  id         String           @id @default(uuid())
  schoolId   String           @map("school_id")
  at         DateTime         @default(now())
  date       String
  studentId  String           @map("student_id")
  guardianId String           @map("guardian_id")
  kind       ParentNoticeKind
  delivered  Boolean          @default(false)

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([studentId, date, kind, guardianId])
  @@index([schoolId, at(sort: Desc)])
  @@map("school_parent_notices")
}

// ─────────────────────────────────────────────────────────────────────
// Parvoz School (2-to'lqin): xabarlar, School Mode, g'amxo'rlik,
// psixologik testlar, xodim bildirishnomalari, maktab topshiriqlari.
// `*Enc` — AES-256-GCM bilan shifrlangan (bolaning xom javoblari / matnlari).
// ─────────────────────────────────────────────────────────────────────

enum SchoolMessageStatus {
  DRAFT
  SCHEDULED
  SENT
}

/// E'lon. `audience` — { kind: SCHOOL | CLASSES | GUARDIANS, classIds, guardianIds }.
model SchoolAnnouncement {
  id          String              @id @default(uuid())
  schoolId    String              @map("school_id")
  title       String
  body        String
  audience    Json
  priority    String              @default("NORMAL")
  status      SchoolMessageStatus @default(DRAFT)
  scheduledAt DateTime?           @map("scheduled_at")
  sentAt      DateTime?           @map("sent_at")
  byStaffId   String              @map("by_staff_id")
  recipients  Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  school     School                       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  deliveries SchoolAnnouncementDelivery[]

  @@index([schoolId, status])
  @@index([status, scheduledAt])
  @@map("school_announcements")
}

/// Vasiyga yetkazilishi (push) va o'qilishi — e'lon statistikasi shundan.
model SchoolAnnouncementDelivery {
  id             String    @id @default(uuid())
  announcementId String    @map("announcement_id")
  guardianId     String    @map("guardian_id")
  userId         String?   @map("user_id")
  deliveredAt    DateTime? @map("delivered_at")
  readAt         DateTime? @map("read_at")

  announcement SchoolAnnouncement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, guardianId])
  @@index([userId])
  @@map("school_announcement_deliveries")
}

model SchoolReminder {
  id         String    @id @default(uuid())
  schoolId   String    @map("school_id")
  kind       String
  title      String
  body       String
  audience   Json
  sendAt     DateTime  @map("send_at")
  repeat     String    @default("NONE")
  active     Boolean   @default(true)
  byStaffId  String    @map("by_staff_id")
  lastSentAt DateTime? @map("last_sent_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([active, sendAt])
  @@map("school_reminders")
}

/// To'lov eslatmasi — platforma qarz hisoblamaydi, faqat keyingi sana.
model SchoolPaymentReminder {
  id            String    @id @default(uuid())
  schoolId      String    @map("school_id")
  guardianId    String    @map("guardian_id")
  studentIds    String[]  @map("student_ids")
  nextDate      String    @map("next_date")
  prepaidMonths Int       @default(0) @map("prepaid_months")
  paused        Boolean   @default(false)
  /// [{ at, byStaffId, action, note }]
  history       Json      @default("[]")
  lastSentAt    DateTime? @map("last_sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  school        School                      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  verifications SchoolVerificationRequest[]

  @@unique([schoolId, guardianId])
  @@index([schoolId, nextDate])
  @@map("school_payment_reminders")
}

/// Ota-onaning "to'laganman, tekshiring" so'rovi.
model SchoolVerificationRequest {
  id                String    @id @default(uuid())
  schoolId          String    @map("school_id")
  guardianId        String    @map("guardian_id")
  paymentReminderId String    @map("payment_reminder_id")
  message           String
  status            String    @default("OPEN")
  answer            String?
  answeredByStaffId String?   @map("answered_by_staff_id")
  answeredAt        DateTime? @map("answered_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  school  School                @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  payment SchoolPaymentReminder @relation(fields: [paymentReminderId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("school_verification_requests")
}

/// School Mode siyosati (smenalar bo'yicha). `allowedApps` — [{ id, name, category }].
model SchoolModePolicy {
  id                String   @id @default(uuid())
  schoolId          String   @map("school_id")
  name              String
  blockedCategories String[] @map("blocked_categories")
  allowedApps       Json     @default("[]") @map("allowed_apps")
  shiftIds          String[] @map("shift_ids")
  enabled           Boolean  @default(true)
  relaxDuringBreaks Boolean  @default(true) @map("relax_during_breaks")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_mode_policies")
}

model SchoolModeException {
  id        String    @id @default(uuid())
  schoolId  String    @map("school_id")
  studentId String    @map("student_id")
  classId   String?   @map("class_id")
  from      DateTime
  until     DateTime
  reason    String
  byStaffId String    @map("by_staff_id")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, until])
  @@index([studentId])
  @@map("school_mode_exceptions")
}

/// Favqulodda rejim (maktab yoki sinflar bo'yicha cheklovni darhol ochish).
model SchoolEmergency {
  schoolId  String    @id @map("school_id")
  active    Boolean   @default(false)
  scope     String    @default("SCHOOL")
  classIds  String[]  @map("class_ids")
  reason    String    @default("")
  byStaffId String?   @map("by_staff_id")
  at        DateTime?
  updatedAt DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("school_emergencies")
}

model SchoolCareQuestion {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  topic     String
  ageGroups String[] @map("age_groups")
  /// { uz, ru }
  text      Json
  reverse   Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@map("school_care_questions")
}

model SchoolCareSurvey {
  id          String    @id @default(uuid())
  schoolId    String    @map("school_id")
  title       String
  weekStart   String    @map("week_start")
  ageGroups   String[]  @map("age_groups")
  questionIds String[]  @map("question_ids")
  status      String    @default("DRAFT")
  invited     Int       @default(0)
  activatedAt DateTime? @map("activated_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  school    School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  responses SchoolCareResponse[]

  @@index([schoolId, status])
  @@map("school_care_surveys")
}

/// Xom javob (shifrlangan) — faqat psixolog yo'li o'qiydi.
model SchoolCareResponse {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  surveyId    String   @map("survey_id")
  studentId   String   @map("student_id")
  classId     String?  @map("class_id")
  grade       Int
  answersEnc  String   @map("answers_enc")
  submittedAt DateTime @default(now()) @map("submitted_at")

  school School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  survey SchoolCareSurvey @relation(fields: [surveyId], references: [id], onDelete: Cascade)

  @@unique([surveyId, studentId])
  @@index([schoolId, surveyId])
  @@map("school_care_responses")
}

/// Bolaning murojaati (matn va eslatmalar shifrlangan).
model SchoolCareRequest {
  id                String    @id @default(uuid())
  schoolId          String    @map("school_id")
  studentId         String    @map("student_id")
  classId           String?   @map("class_id")
  topic             String
  messageEnc        String    @map("message_enc")
  urgency           String    @default("NORMAL")
  status            String    @default("NEW")
  meetingAt         DateTime? @map("meeting_at")
  notesEnc          String?   @map("notes_enc")
  protocolActivated Boolean   @default(false) @map("protocol_activated")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@index([studentId])
  @@map("school_care_requests")
}

/// Maktabning o'z / import qilingan testi (`definition` — PsychTest tanasi).
model SchoolPsychTest {
  id         String   @id @default(uuid())
  schoolId   String   @map("school_id")
  definition Json
  version    Int      @default(1)
  status     String   @default("DRAFT")
  createdBy  String?  @map("created_by")
  basedOn    String?  @map("based_on")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("school_psych_tests")
}

/// Shablon testlar kodda; maktabga xos holat va me'yor o'zgarishlari shu yerda.
model SchoolPsychTemplateState {
  schoolId   String   @map("school_id")
  templateId String   @map("template_id")
  status     String   @default("PUBLISHED")
  norms      Json?
  updatedAt  DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@id([schoolId, templateId])
  @@map("school_psych_template_states")
}

model SchoolPsychAssignment {
  id          String   @id @default(uuid())
  schoolId    String   @map("school_id")
  testId      String   @map("test_id")
  testVersion Int      @map("test_version")
  target      Json
  classIds    String[] @map("class_ids")
  opensAt     DateTime @map("opens_at")
  closesAt    DateTime @map("closes_at")
  status      String   @default("OPEN")
  invited     Int      @default(0)
  consent     String   @default("PARENTS_INFORMED")
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, status])
  @@map("school_psych_assignments")
}

/// Natija: faqat xom ballar (standart ball / persentil o'qilganda hisoblanadi).
model SchoolPsychResult {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  studentId    String   @map("student_id")
  classId      String?  @map("class_id")
  grade        Int
  ageBand      String   @map("age_band")
  testId       String   @map("test_id")
  version      Int
  assignmentId String?  @map("assignment_id")
  takenAt      DateTime @map("taken_at")
  origin       String
  /// scaleKey → xom ball.
  raw          Json
  answersEnc   String?  @map("answers_enc")
  durationSec  Int?     @map("duration_sec")
  createdAt    DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  /// Tayinlash bo'yicha o'quvchiga bitta natija (CSV importdagi tayinlashsiz natija — NULL, cheklanmaydi).
  @@unique([assignmentId, studentId])
  @@index([schoolId, testId])
  @@index([studentId, takenAt(sort: Desc)])
  @@map("school_psych_results")
}

/// Saqlanadigan xodim bildirishnomasi (xavfsizlik signali, test yakunlandi).
model SchoolStaffNotification {
  id       String   @id @default(uuid())
  schoolId String   @map("school_id")
  kind     String
  at       DateTime @default(now())
  roles    String[]
  /// Bo'sh — butun maktab; aks holda shu sinflar doirasidagilarga.
  classIds String[] @map("class_ids")
  params   Json     @default("{}")
  subject  Json?
  href     String?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, at(sort: Desc)])
  @@map("school_staff_notifications")
}

/// Xodim o'qigan bildirishnomalar (saqlanadigan va hisoblanadiganlar kaliti).
model SchoolNotificationRead {
  staffId String   @map("staff_id")
  key     String
  readAt  DateTime @default(now()) @map("read_at")

  @@id([staffId, key])
  @@map("school_notification_reads")
}

/// O'qituvchi topshirig'i: Parvoz kontenti (video / audiokitob / test) sinflarga.
model SchoolLearningAssignment {
  id           String   @id @default(uuid())
  schoolId     String   @map("school_id")
  materialKind String   @map("material_kind")
  materialId   String   @map("material_id")
  classIds     String[] @map("class_ids")
  dueDate      String   @map("due_date")
  note         String   @default("")
  byStaffId    String   @map("by_staff_id")
  createdAt    DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId, dueDate])
  @@map("school_learning_assignments")
}
