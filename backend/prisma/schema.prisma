  @@unique([childId, date])
  @@index([childId, date])
  @@map("child_step_daily")
}

// --- Child pair-request: re-pair flow Parent confirm bilan ---
// Bola App reinstall qildi yoki yangi qurilma → familyCode bilan ulanmoqchi,
// lekin child.childUserId allaqachon mavjud. Parent tasdiqlasagina re-pair.
// Security: kim familyCode bilsa, parent confirm'siz bola accountini o'g'irlay olmaydi.
model ChildPairRequest {
  id         String            @id @default(uuid())
  childId    String            @map("child_id")
  status     PairRequestStatus @default(PENDING)
  deviceInfo Json?             @map("device_info")
  ipAddress  String?           @map("ip_address")
  userAgent  String?           @map("user_agent")
  // Approved bo'lganda yaratilgan yangi User (polling orqali bola JWT oladi)
  newUserId  String?           @map("new_user_id")
  createdAt  DateTime          @default(now()) @map("created_at")
  decidedAt  DateTime?         @map("decided_at")
  expiresAt  DateTime          @map("expires_at")

  child Child @relation(fields: [childId], references: [id], onDelete: Cascade)

  @@index([childId, status])
  @@index([status, expiresAt])
  @@map("child_pair_requests")
}

enum PairRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// --- Session access request: ota-ona akaunti 2-qurilma limiti ---
// Akauntda maksimal 2 faol seans (UserSession revokedAt=null). 3-qurilma
// login qilsa (parol to'g'ri) — token berilmaydi, bu so'rov yaratiladi va
// 2 ta ulangan qurilmaga push boradi. Biri tasdiqlab, Faol seanslardan
// bittasini chiqargach, so'rovchi qurilma poll orqali kiradi (doim max 2).
// Xavfsizlik: `pollToken` maxfiy — faqat so'rovchi qurilma poll qila oladi.
model SessionAccessRequest {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  status      SessionAccessStatus @default(PENDING)
  pollToken   String              @map("poll_token")
  deviceModel String?             @map("device_model")
  platform    String?
  ipAddress   String?             @map("ip_address")
  userAgent   String?             @map("user_agent")
  createdAt   DateTime            @default(now()) @map("created_at")
  decidedAt   DateTime?           @map("decided_at")
  consumedAt  DateTime?           @map("consumed_at")
  expiresAt   DateTime            @map("expires_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("session_access_requests")
}

enum SessionAccessStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// --- App limits (per-package daily/weekly limit, YouTube/TikTok addiction) ---
// Window-based Schedule (BLOCK/ALLOW) bilan birga ishlaydi:
//   Schedule = vaqt oraliq (21:00-07:00 BLOCK barcha apps)
//   AppLimit = per-package quota (com.youtube 15 min/kun)
model AppLimit {
  id            String   @id @default(uuid())
  childId       String   @map("child_id")
