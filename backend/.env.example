# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# CORS — vergul bilan ajratilgan ruxsat etilgan origin'lar
CORS_ORIGINS=https://farzandimedu.uz

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/farzandim?schema=public"

# Telegram Login
TELEGRAM_BOT_TOKEN=<from-BotFather>
TELEGRAM_BOT_USERNAME=<bot-username-without-@>

# JWT (openssl rand -hex 32)
JWT_ACCESS_SECRET=<64-hex>
JWT_REFRESH_SECRET=<64-hex>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Admin panel JWT (Sprint 5.1) — alohida sirlar, audience='admin-panel'.
# Sirlar JWT_*_SECRET bilan ustma-ust kelmasligi kerak.
ADMIN_JWT_ACCESS_SECRET=<64-hex>
ADMIN_JWT_REFRESH_SECRET=<64-hex>
ADMIN_JWT_ACCESS_EXPIRES=15m
ADMIN_JWT_REFRESH_EXPIRES=30d

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=<minio-user>
MINIO_SECRET_KEY=<minio-password-64-hex>
MINIO_PUBLIC_URL=https://farzandimedu.uz

# FCM (Firebase Cloud Messaging) — push notifications
# Optional: agar bo'sh bo'lsa push send'siz token CRUD ishlaydi.
# Service account JSON ni base64'ga aylantirib bering:
#   base64 -w 0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ============================================
# To'lov provayderlari (Sprint 6) — hammasi optional.
# Kalit yo'q bo'lsa provayder o'chiq turadi, checkout 503 qaytaradi.
# Kalitlar kiritilгач avtomatik yoqiladi (restart kerak).
# ============================================
PUBLIC_BASE_URL=https://farzandimedu.uz

# Payme — Merchant Cabinet (cabinet.paycom.uz) dan olinadi.
# Webhook manzili (Payme'ga beriladi):
#   https://farzandimedu.uz/api/payments/webhook/payme
#
# ⚠️ PAYME_MERCHANT_KEY — BIR VAQTDA FAQAT BITTA kalit:
#   • Sinov bosqichi (test.paycom.uz sandbox) → TEST kaliti
#   • Payme tasdiqlagach, jonli ishga o'tishda → PRODUCTION kaliti
# Ikkalasini birga qabul qilish XAVFLI: kalitni bilgan odam CreateTransaction
# + PerformTransaction chaqirib, to'lamasdan o'ziga obuna yozdirishi mumkin
# (payment_id o'z checkout'idan olinadi). Test kaliti odatda guruhda ochiq
# yuboriladi — shuning uchun jonli ishga o'tishda ALBATTA almashtiring.
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=

# Payme FISKALIZATSIYA (soliq cheki) — CheckPerformTransaction javobidagi
# `detail.items[]` uchun. Ikkalasi (MXIK + package_code) to'ldirilmaguncha
# `detail` javobga QO'SHILMAYDI va chek soliq oborotiga tushmaydi.
#   MXIK (ИКПУ) kodi: tasnif.soliq.uz dan xizmat turi bo'yicha topiladi
#   package_code:     tasnif.soliq.uz/attribute/<MXIK> sahifasidan
PAYME_FISCAL_MXIK=
PAYME_FISCAL_PACKAGE_CODE=
# QQS foizi: 0 = QQS to'lovchisi emas; O'zbekistonda standart stavka 12.
PAYME_FISCAL_VAT_PERCENT=0

# Click — Merchant Cabinet (merchant.click.uz) dan olinadi
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Uzum Bank (ESKI, checkout modeli) — Merchant Cabinet dan olinadi.
# Hozir O'CHIQ (uzum.provider.ts: UZUM_VERIFIED = false).
UZUM_MERCHANT_SERVICE_ID=
UZUM_SECRET_KEY=
UZUM_API_BASE=

# ── Uzum Bank MERCHANT API (yangi, ishlatiladigan integratsiya) ──────
# Foydalanuvchi UZUM ILOVASI ichida "Parvoz" xizmatini topib, telefon
# raqamini kiritib to'laydi. Uzum bizga so'rov yuboradi:
#   POST /api/uzum/merchant/{check,create,confirm,reverse,status}
#
# Login va parolni BIZ o'ylab topamiz va Uzum'ga beramiz (ular shu bilan
# Basic auth qiladi). Bo'sh bo'lsa endpointlar 401 qaytaradi.
UZUM_MERCHANT_USERNAME=
UZUM_MERCHANT_PASSWORD=
# serviceId: test bosqichida biz beramiz, keyin Uzum o'zinikini beradi.
UZUM_MERCHANT_API_SERVICE_ID=

# SMS — Eskiz.uz (telefon OTP). Kalit yo'q bo'lsa SMS o'chiq.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# Email (SMTP) — EMAIL orqali ro'yxatdan o'tish kodi (email OTP) shu orqali
# yuboriladi. SMTP_USER + SMTP_PASS BO'SH bo'lsa email-OTP ISHLAMAYDI
# (endpoint 503 beradi, kod'ni emailga yuborolmaydi). PROD serverda ham
# qo'lda to'ldirish SHART (deploy .env'ni exclude qiladi).
# Gmail: PASS = 16-belgili "App Password" (oddiy parol EMAS).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Parvoz <no-reply@farzandimedu.uz>

# ============================================
# Ijtimoiy login (Sprint 7) — hammasi optional.
# Bo'sh bo'lsa /auth/google va /auth/apple 401 qaytaradi.
# ============================================

# Google OAuth Client ID'lar (vergul bilan ajratilgan: web,android,ios).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Web: "Web application" turi, Authorized JavaScript origins'da web domain.
# Android: "Android" turi, SHA-1 fingerprint kerak.
# iOS: "iOS" turi, bundle ID (com.farzandim.app).
# Google Sign-In Web Client ID ("Parvoz" GCP loyihasi) — maxfiy emas, ochiq identifikator
GOOGLE_CLIENT_IDS=931495868029-b7keq7og9afennh7h3smfaunlf34tsuh.apps.googleusercontent.com

# Apple Sign In — App ID (iOS bundle ID). Parent ilova: uz.parvoz.parent.
# Apple Developer'da App ID yaratganda "Sign In with Apple" yoqilgan bo'lishi shart.
APPLE_BUNDLE_ID=

# Apple IAP (StoreKit) obuna kvitansiyasini tekshirish uchun shared secret —
# App Store Connect > App > App Information > App-Specific Shared Secret.
# O'rnatilmagan bo'lsa POST /payments/apple/verify 503 qaytaradi (iOS obuna
# ishlamaydi, lekin boshqa hech narsa buzilmaydi).
APPLE_IAP_SHARED_SECRET=

# ⚠️ StoreKit 2 (JWS) tekshiruvi uchun MAJBURIY — busiz TestFlight va App
# Store'dagi HAQIQIY xaridlar tekshirilmaydi (foydalanuvchi pul to'laydi,
# obuna olmaydi). Qiymat: App Store Connect > Ilova > App Information >
# "Apple ID" ostidagi RAQAM (masalan 6740000000).
APPLE_APP_APPLE_ID=

# Apple sertifikatining bekor qilinganini OCSP orqali online tekshirish.
# Bo'sh qoldiring (= yoqilgan). Server Apple'ga chiqa olmasa: false
APPLE_IAP_ONLINE_CHECKS=

# Google Play / App Store reviewer uchun maxsus (demo) bola profili oila kodi.
# Shu kod bilan pairing HAR DOIM ishlaydi (qayta ulanish 409 bermaydi).
# Faqat ataylab yaratilgan demo profil kodini qo'ying.
PLAY_REVIEW_FAMILY_CODE=

# OTA-ONA ilovasi uchun reviewer demo akkaunt email'i. Shu akkauntga
# "2 qurilma" limiti qo'llanmaydi (tekshiruvchi bloklanmasin).
PLAY_REVIEW_PARENT_EMAIL=

# Apple Service ID (web/Android OAuth uchun, masalan com.farzandim.web).
# Apple Developer'da alohida Service ID yaratiladi va rhttp://192.168.0.222:5616/eturn URL ro'yxatdan o'tkaziladi.
APPLE_SERVICE_ID=
