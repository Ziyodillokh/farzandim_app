# Server
NODE_ENV=development
PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# CORS — vergul bilan ajratilgan ruxsat etilgan origin'lar
CORS_ORIGINS=https://farzandimedu.uz

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/farzandim?schema=public"

# Telegram Login
TELEGRAM_BOT_TOKEN=<from-BotFather>
TELEGRAM_BOT_USERNAME=<bot-username-without-@>

# JWT (openssl rand -hex 32)
JWT_ACCESS_SECRET=<64-hex>
JWT_REFRESH_SECRET=<64-hex>
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# Admin panel JWT (Sprint 5.1) — alohida sirlar, audience='admin-panel'.
# Sirlar JWT_*_SECRET bilan ustma-ust kelmasligi kerak.
ADMIN_JWT_ACCESS_SECRET=<64-hex>
ADMIN_JWT_REFRESH_SECRET=<64-hex>
ADMIN_JWT_ACCESS_EXPIRES=15m
ADMIN_JWT_REFRESH_EXPIRES=30d

# MinIO
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=<minio-user>
MINIO_SECRET_KEY=<minio-password-64-hex>
MINIO_PUBLIC_URL=https://farzandimedu.uz

# FCM (Firebase Cloud Messaging) — push notifications
# Optional: agar bo'sh bo'lsa push send'siz token CRUD ishlaydi.
# Service account JSON ni base64'ga aylantirib bering:
#   base64 -w 0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=

# ============================================
# To'lov provayderlari (Sprint 6) — hammasi optional.
# Kalit yo'q bo'lsa provayder o'chiq turadi, checkout 503 qaytaradi.
# Kalitlar kiritilгач avtomatik yoqiladi (restart kerak).
# ============================================
PUBLIC_BASE_URL=https://farzandimedu.uz

# Payme — Merchant Cabinet (cabinet.paycom.uz) dan olinadi
PAYME_MERCHANT_ID=
PAYME_MERCHANT_KEY=

# Click — Merchant Cabinet (merchant.click.uz) dan olinadi
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_MERCHANT_USER_ID=

# Uzum Bank — Merchant Cabinet dan olinadi
UZUM_MERCHANT_SERVICE_ID=
UZUM_SECRET_KEY=
UZUM_API_BASE=

# SMS — Eskiz.uz (telefon OTP). Kalit yo'q bo'lsa SMS o'chiq.
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546

# ============================================
# Ijtimoiy login (Sprint 7) — hammasi optional.
# Bo'sh bo'lsa /auth/google va /auth/apple 401 qaytaradi.
# ============================================

# Google OAuth Client ID'lar (vergul bilan ajratilgan: web,android,ios).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs.
# Web: "Web application" turi, Authorized JavaScript origins'da web domain.
# Android: "Android" turi, SHA-1 fingerprint kerak.
# iOS: "iOS" turi, bundle ID (com.farzandim.app).
GOOGLE_CLIENT_IDS=

# Apple Sign In — App ID (iOS bundle ID, masalan com.farzandim.app).
# Apple Developer'da App ID yaratganda "Sign In with Apple" yoqilgan bo'lishi shart.
APPLE_BUNDLE_ID=

# Apple Service ID (web/Android OAuth uchun, masalan com.farzandim.web).
# Apple Developer'da alohida Service ID yaratiladi va return URL ro'yxatdan o'tkaziladi.
APPLE_SERVICE_ID=
