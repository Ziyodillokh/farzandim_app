<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- ==================================================================
	     Parvoz Parents (uz.parvoz.parent) — Apple Privacy Manifest
	     2024-05-01 dan majburiy. Bu manifest FAQAT Runner (ilovaning O'Z
	     kodi) uchun. Firebase, shared_preferences, path_provider va boshqa
	     CocoaPods pod'lari O'Z PrivacyInfo.xcprivacy fayllarini olib keladi.
	     MUHIM: bu fayl Xcode'da Runner target > Build Phases > Copy Bundle
	     Resources ro'yxatida bo'lishi SHART, aks holda ITMS-91053 qaytadi.
	     ================================================================== -->

	<!-- Ad-tracking QILINMAYDI: IDFA/ATT yo'q, reklama SDK yo'q, ma'lumot
	     broker'ga berilmaydi, cross-app linking yo'q. Firebase Analytics
	     faqat birinchi-tomon DAU/MAU/screen tracking uchun. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!-- ===== Required Reason API'lar ================================== -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- UserDefaults: shared_preferences (til, bildirishnoma tarixi),
		     easy_localization, package_info_plus — ilovaning O'ZIGA tegishli
		     sozlamalarni o'qish/yozish. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- File timestamp: path_provider (temp audio yo'li), cached_network_image
		     (rasm keshi), file_picker / open_filex — app konteyneridagi fayl
		     metama'lumotlari (vaqt/o'lcham). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
		<!-- System boot time: dio timeout, socket_io_client, animatsiya/taymer —
		     o'tgan vaqtni o'lchash (mach_absolute_time / systemUptime). -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategorySystemBootTime</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>35F9.1</string>
			</array>
		</dict>
		<!-- Disk space: video_compress, cached_network_image, record/video/foto
		     yozishdan OLDIN bo'sh joyni tekshirish. Foydalanuvchiga
		     KO'RSATILMAYDI, shuning uchun E174.1 emas 85F4.1. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>85F4.1</string>
			</array>
		</dict>
	</array>

	<!-- ===== Yig'iladigan ma'lumot turlari =========================== -->
	<!-- Eslatma: Crash Data, Performance Data, Product Interaction (analitika)
	     bu yerda YO'Q — Firebase pod'lari (Crashlytics/Analytics/Messaging)
	     o'z manifestlarida e'lon qiladi. Lekin App Store Connect "App Privacy"
	     nutrition label'iga ULARNI ham qo'lda qo'shish SHART. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!-- Aniq joylashuv: bola joylashuvi/tarixi, geo-zona koordinatalari,
		     ota-onaning xaritadagi o'z joyi. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePreciseLocation</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Ism (ro'yxatdan o'tish / profil). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeName</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Email manzil. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeEmailAddress</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Telefon raqami. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhoneNumber</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Foto/Video: bola/ota-ona avatari, video xabarlar. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Audio: ovozli xabarlar (record). -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeAudioData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Boshqa foydalanuvchi kontenti: chat matnli xabarlar. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherUserContent</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- User ID: backend akkaunt UUID. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
		<!-- Device ID: FCM push token + device_info_plus deviceId
		     (POST /fcm/tokens) — push yo'naltirish va sessiya boshqaruvi. -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
