<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Parvoz Parents</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>farzandim</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<!-- Ruxsat tushuntirishlari. iOS App Store "usage description" majburiy —
	     yo'q bo'lsa ilova o'sha ruxsatni so'raganda DARHOL crash bo'ladi. -->
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Bola fotosini tanlash uchun galereyaga kirish kerak</string>
		<key>NSCameraUsageDescription</key>
		<string>Bola fotosini olish, QR-kod skanerlash va video xabar yozish uchun kamera kerak</string>
		<!-- record ^5.1.2 (ovozli/video xabar) mikrofon so'raganda bu kalitsiz
	     iOS ilovani darhol o'ldiradi (reviewer aynan shuni sinaydi). -->
		<key>NSMicrophoneUsageDescription</key>
		<string>Ovozli va video xabar yozish uchun mikrofon kerak</string>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Xaritada o'z joylashuvingizni ko'rsatish uchun kerak</string>
		<!-- Ota-ona ilovasi doimiy (background) joylashuvni SO'RAMAYDI — Dart
	     kodida faqat `Geolocator.requestPermission()` (when-in-use) bor.
	     Lekin geolocator_apple va permission_handler_apple manbalarida
	     `requestAlwaysAuthorization` API'siga havola bor, App Store yuklash
	     tahlili esa shu havolani ko'rib tushuntirish matnini talab qiladi
	     (ogohlantirish 90683). Busiz har yuklashda warning keladi. Matn
	     amalda foydalanuvchiga ko'rsatilmaydi, chunki bu ruxsat so'ralmaydi. -->
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Xaritada o'z joylashuvingizni ko'rsatish uchun kerak. Ilova joylashuvni orqa fonda kuzatmaydi.</string>
		<!-- Eksport muvofiqligi: ilova faqat standart HTTPS/TLS ishlatadi (ozod).
	     Busiz App Store Connect har build'da eksport savolini so'raydi. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Google Sign-In iOS OAuth redirect sxemasi = GoogleService-Info.plist
	     ichidagi REVERSED_CLIENT_ID (farzandim-mvp loyihasining iOS OAuth
	     client'i). Bu qiymat o'sha plist bilan bir xil bo'lishi SHART, aks
	     holda Google oynasi ochilib, ilovaga qaytmaydi. Sign in with Apple
	     bunga bog'liq emas — u shusiz ham ishlaydi. -->
		<key>CFBundleURLTypes</key>
		<array>
			<dict>
				<key>CFBundleTypeRole</key>
				<string>Editor</string>
				<key>CFBundleURLSchemes</key>
				<array>
					<string>com.googleusercontent.apps.163835260058-q6ngmkie0fp00t666vnh6amnfphcqo46</string>
				</array>
			</dict>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
	</dict>
</plist>
