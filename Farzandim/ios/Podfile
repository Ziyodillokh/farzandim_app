# Minimal iOS 15.5 — eng baland talab qo'ygan plagin bo'yicha:
#   mobile_scanner 6.0.11 podspec => s.platform = :ios, '15.5.0'
# (Firebase iOS SDK 11.x o'zi 13.0 bilan ham kifoya qilardi, lekin
#  CocoaPods eng balandiga tenglashtiradi — 13.0 qolsa "could not find
#  compatible versions for mobile_scanner" bilan yiqiladi.)
# Qamrov: iPhone 6s va undan yangi qurilmalar.
platform :ios, '15.5'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    # ⚠️ permission_handler MAKROLARI — MAJBURIY.
    #
    # `permission_handler_apple` iOS'da BARCHA ruxsatlarni standart holatda
    # O'CHIRIB keladi (PermissionHandlerEnums.h: `#define PERMISSION_CAMERA 0`
    # va h.k.). Ular shu yerda oshkora yoqilmasa, tegishli kod ilovaga
    # umuman kompilyatsiya qilinmaydi va plagin HAR DOIM "rad etilgan"
    # qaytaradi — iOS ruxsat so'rovi HECH QACHON chiqmaydi.
    #
    # 2026-08-22 da haqiqiy qurilmada aynan shu aniqlandi: chatda ovozli va
    # video xabar ishlamasdi, ilova to'g'ridan-to'g'ri "Sozlamalarni oching"
    # deb yozardi, Sozlamalarda esa Kamera/Mikrofon qatorlari umuman
    # ko'rinmasdi (tizim hech qachon so'ralmagani uchun).
    #
    # Joylashuv va bildirishnoma ta'sirlanmagan edi, chunki ular
    # `geolocator` va Firebase orqali so'raladi — permission_handler'dan
    # o'tmaydi.
    #
    # Ro'yxat ilovada HAQIQATAN ishlatiladigan ruxsatlar bilan cheklangan
    # (lib/ bo'ylab `Permission.*` qidiruvi): camera, microphone,
    # notification. Yangi ruxsat qo'shilsa — bu yerga ham qo'shilsin.
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_CAMERA=1',
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_NOTIFICATIONS=1',
      ]
    end
  end
end
