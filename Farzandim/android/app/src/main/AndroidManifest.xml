<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Bola fotosini tanlash uchun ruxsatlar (image_picker paketi). -->
    <!-- Android 12 va eski: galereyaga umumiy kirish. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <!-- Android 13+: yangi granular media ruxsati (faqat rasmlar). -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
    <!-- Kamera — foydalanuvchi yangi foto olishni xohlasa. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <!-- Kamerasiz qurilmalarda ham ilova ishlaydi (sticker'lar bor). -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <!-- Internet — Firebase, FCM, Google Maps tile'lari uchun.
         Location permission'lar Parent App'da YO'Q: ota-ona telefonidan
         GPS o'qilmaydi, bola joyi Child App'dan Firestore orqali keladi. -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Bosqich 6.B: FCM push notifications. Android 13+ explicit
         POST_NOTIFICATIONS permission talab qiladi (eski Android'da
         avtomatik beriladi). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Bosqich 10: Ovozli xabar yozish uchun mikrofon ruxsati.
         `record` paketi `permission_handler` orqali runtime'da so'raydi —
         shu manifest deklaratsiyasi mavjud bo'lishi shart. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <application
        android:label="Farzandim"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <!-- Google Maps SDK API kaliti.
             ${MAPS_API_KEY} build vaqtida `local.properties`'dan
             `app/build.gradle.kts` orqali in'ektsiya qilinadi.
             Kalit topilmasa, xarita kulrang ko'rinadi (build muvaffaqiyatli). -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${MAPS_API_KEY}"/>

        <!-- FCM default notification channel (Bosqich 6.B).
             Android 8.0+ majburiy. Push xabarlar shu channel'ga keladi
             agar yuboruvchi explicit channel_id bermasa. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="farzandim_default"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
