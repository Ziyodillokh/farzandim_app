 "lib/features/legal/data/legal_text.dart": [
  {
   "line": 51,
   "text": "$_appName — ota-onalar va vasiylar uchun mo\\'ljallangan oilaviy "
  },
  {
   "line": 65,
   "text": "   • Telefon raqami (Phone OTP autentifikatsiyasi uchun)\\n"
  },
  {
   "line": 66,
   "text": "   • Email manzili (ixtiyoriy, parol tiklash uchun)\\n"
  },
  {
   "line": 68,
   "text": "   • Qurilma identifikatori (FCM token push xabarlar uchun)\\n"
  },
  {
   "line": 70,
   "text": "aniqlash uchun)\\n\\n"
  },
  {
   "line": 74,
   "text": "   • Joriy GPS joylashuv (bola qurilmasi ruxsati bilan)\\n"
  },
  {
   "line": 75,
   "text": "   • Wi-Fi tarmoq nomi (joylashuv aniqligini oshirish uchun)\\n"
  },
  {
   "line": 77,
   "text": "sozlamalarini ta\\'minlash uchun)\\n"
  },
  {
   "line": 80,
   "text": "sotish uchun ishlatilmaydi."
  },
  {
   "line": 84,
   "text": "Ma\\'lumotlar quyidagi maqsadlarda qayta ishlanadi:\\n\\n"
  },
  {
   "line": 87,
   "text": "   • Ota-ona nazorati (ilova cheklovlari, jadval)\\n"
  },
  {
   "line": 88,
   "text": "   • Ovozli va video xabarlar (oila aloqasi)\\n"
  },
  {
   "line": 94,
   "text": "(voyaga yetmagan shaxslarga oid ma\\'lumotlarni qayta ishlash "
  },
  {
   "line": 98,
   "text": "   • GDPR (Yevropa hududidagi foydalanuvchilar uchun, agar "
  },
  {
   "line": 100,
   "text": "ma\\'lumotlar uchun ota-ona roziligi (Art. 8)"
  },
  {
   "line": 128,
   "text": "   • Tizim loglari: maksimum 1 yil (xavfsizlik va xato "
  },
  {
   "line": 129,
   "text": "tahlili uchun)\\n"
  },
  {
   "line": 138,
   "text": "13 yoshdan kichik bolalar uchun maxsus himoya choralari "
  },
  {
   "line": 145,
   "text": "       - reklama uchun ishlatilmaydi\\n"
  },
  {
   "line": 147,
   "text": "       - profiling yoki targeting uchun ishlatilmaydi\\n"
  },
  {
   "line": 148,
   "text": "       - texnik xizmatdan tashqari uchinchi tomon bilan "
  },
  {
   "line": 150,
   "text": "Ota-ona istalgan vaqtda bola ma\\'lumotlarini ko\\'rishi, "
  },
  {
   "line": 151,
   "text": "tahrirlashi yoki o\\'chirishi mumkin (Sozlamalar → Bolalar "
  },
  {
   "line": 154,
   "text": "Bola foydalanuvchi emas — vasiy mahsulot foydalanuvchisi. "
  },
  {
   "line": 156,
   "text": "sozlashi mumkin."
  },
  {
   "line": 162,
   "text": "(o\\'zingiz) va Sozlamalar → Bolalar boshqaruvi (bola "
  },
  {
   "line": 164,
   "text": "   • Tahrirlash: barcha kiritilgan maydonlar (ism, telefon, "
  },
  {
   "line": 165,
   "text": "email, profil rasmi, bola ma\\'lumotlari) tahrirlanadi\\n"
  },
  {
   "line": 169,
   "text": "   • E\\'tiroz bildirish: agar qayta ishlashga qarshi "
  },
  {
   "line": 178,
   "text": "Ma\\'lumotlar quyidagi texnik vositalar bilan himoyalangan:\\n\\n"
  },
  {
   "line": 185,
   "text": "reverse-engineered klientlarni bloklash\\n"
  },
  {
   "line": 194,
   "text": "Ushbu maxfiylik siyosati vaqti-vaqti bilan yangilanishi mumkin. "
  },
  {
   "line": 204,
   "text": "Maxfiylik bilan bog\\'liq savol yoki shikoyatlaringiz uchun:\\n\\n"
  },
  {
   "line": 207,
   "text": "O\\'zbekiston Respublikasida ma\\'lumotlarni qayta ishlash "
  },
  {
   "line": 231,
   "text": "vasiy) tomonidan o\\'rnatilishi va foydalanilishi mumkin. "
  },
  {
   "line": 236,
   "text": "$_appName — bola xavfsizligi va ota-ona nazoratiga "
  },
  {
   "line": 242,
   "text": "   • Ovozli va video xabarlar (oila aloqasi)\\n"
  },
  {
   "line": 243,
   "text": "   • Ilova foydalanish vaqtini cheklash (jadval)\\n"
  },
  {
   "line": 244,
   "text": "   • Jadval bo\\'yicha eslatmalar\\n"
  },
  {
   "line": 260,
   "text": "   • APK\\'ni qayta tarqatish\\n\\n"
  },
  {
   "line": 268,
   "text": "   • Bola bilan ochiq muloqot — kuzatuv haqida xabardor "
  },
  {
   "line": 273,
   "text": "Tavsiya: bola yoshi va etukligiga qarab kuzatuv mavjudligi "
  },
  {
   "line": 281,
   "text": "mumkin:\\n\\n"
  },
  {
   "line": 293,
   "text": "tegishli ma\\'lumotlarni butunlay o\\'chirib tashlashi mumkin:\\n\\n"
  },
  {
   "line": 297,
   "text": "   • Profil, bola hisoblari, xabarlar, geo-zonalar, "
  },
  {
   "line": 309,
   "text": "$_legalEntity quyidagi holatlarga javobgar emas:\\n\\n"
  },
  {
   "line": 310,
   "text": "   • Internet aloqasi yo\\'qligi yoki sekinligi\\n"
  },
  {
   "line": 317,
   "text": "Ilova bola xavfsizligini ta\\'minlovchi yagona vosita "
  },
  {
   "line": 318,
   "text": "emas — uni boshqa xavfsizlik choralari (suhbat, "
  },
  {
   "line": 319,
   "text": "tarbiya, jismoniy nazorat) bilan birga qo\\'llang."
  },
  {
   "line": 325,
   "text": "mualliflik huquqi bilan himoyalangan.\\n\\n"
  },
  {
   "line": 329,
   "text": "   • APK\\'ni qayta paketlash va boshqa nom bilan tarqatish\\n"
  },
  {
   "line": 337,
   "text": "$_legalEntity ushbu Shartlarni vaqti-vaqti bilan yangilash "
