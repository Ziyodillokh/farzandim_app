<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ⚠️ Google Play "Stalkerware va Monitoring Applications" siyosati —
         MAJBURIY deklaratsiya. Google'ning RASMIY hujjati bu meta-data'ni
         AYNAN <manifest> darajasida ko'rsatadi (misol shu tegning bevosita
         farzandi sifatida berilgan):
         https://support.google.com/googleplay/android-developer/answer/12955211
         AAPT2 <manifest> ichidagi <meta-data>ni qo'llab-quvvatlaydi.

         MUHIM — DUBLIKAT ATAYLAB: xuddi shu flag <application> ichida ham
         takrorlangan (pastda). Sabab: 2026-08-10 rad xatida "Missing
         isMonitoringTool Flag" deyilgan; qaysi joyni Play skaneri o'qishi
         hujjatlarda noaniq bo'lgani uchun IKKALASI ham qo'yildi — bu
         xavfsizroq va hech qanday zarari yo'q. Ikkalasining qiymati BIR XIL
         bo'lishi shart ("child_monitoring" — ota-ona farzandini nazorat
         qiladi). Birini o'zgartirsangiz, ikkinchisini ham o'zgartiring. -->
    <meta-data
        android:name="isMonitoringTool"
        android:value="child_monitoring"/>

    <uses-permission android:name="android.permission.INTERNET"/>

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION"/>

    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-feature android:name="android.hardware.camera"/>

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- ⚠️ ACCESS_WIFI_STATE va CHANGE_WIFI_STATE OLIB TASHLANDI
         (2026-08-17) — Google Play "Families Device Identifiers" rad javobi.
         Ular Wi-Fi SSID/BSSID o'qish uchun kerak edi (network_info_plus),
         faqat bolalarga mo'ljallangan ilovada esa bu TAQIQLANADI.
         ACCESS_NETWORK_STATE qoladi — u connectivity_plus uchun (internet
         bor/yo'qligini bilish), hech qanday identifikator bermaydi. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Reklama identifikatori (AAID) — Families siyosati bo'yicha TAQIQ.
         Biror kutubxona (Firebase/Play Services) uni tranzitiv qo'shib
         qo'yishi mumkin, shuning uchun manifest merger darajasida majburan
         olib tashlaymiz. Busiz Google avtomatik tekshiruvda rad etadi. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove"/>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>

    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT"/>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>

    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION"/>

    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>

    <!-- READ_PHONE_NUMBERS / READ_PHONE_STATE OLIB TASHLANDI (Google Play
         Families siyosati): bolalar ilovasida SIM'dan telefon raqamini
         avtomatik o'qish shaxsiy identifikator yig'ish hisoblanadi va rad
         etilish sababi bo'ladi. Bola raqamini ota-ona o'z ilovasida qo'lda
         kiritadi — SOS qo'ng'iroq tugmasi o'sha raqamdan ishlaydi. -->

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        android:minSdkVersion="34"
        tools:ignore="UnusedAttribute"/>

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>

    <!-- Health Connect — bugungi QADAM jamini telefonning o'z sog'liq
         ma'lumotidan o'qish (Samsung Health ham shu yerga yozadi). Pedometer
         faqat ilova ishga tushgandan keyingi qadamni sanaydi; Health Connect
         esa butun kunni beradi → ota-ona/bola ilovasidagi son telefondagi
         (Samsung) son bilan mos bo'ladi. -->
    <uses-permission android:name="android.permission.health.READ_STEPS"/>

    <!-- Health Connect ilovasini ko'rish (Android 13 va undan past). -->
    <queries>
        <package android:name="com.google.android.apps.healthdata"/>
    </queries>

    <application
        android:label="Parvoz Growth"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        tools:ignore="DataExtractionRules">
        <!-- ⚠️ Google Play "Monitoring Apps" siyosati — MAJBURIY deklaratsiya:
             ota-ona nazorati ilovalari (bizda QUERY_ALL_PACKAGES,
             PACKAGE_USAGE_STATS, Device Admin uninstall-block, background
             location) shu flag'ni har bir versionCode/trekда e'lon qilishi
             shart, aks holda Play review ilovani "monitoring tool" sifatida
             to'g'ri tasniflay olmaydi va rad etadi.
             Qiymat "child_monitoring" — ota-ona o'z farzandini nazorat
             qilish uchun mo'ljallangan ilova.
             Bu — DUBLIKAT nusxa: asosiysi <manifest> darajasida (fayl
             boshida, Google hujjatidagi rasmiy joy). Ikkalasi ham ataylab
             turibdi, qiymatlari bir xil bo'lishi SHART.
             https://support.google.com/googleplay/android-developer/answer/12955211 -->
        <meta-data
            android:name="isMonitoringTool"
            android:value="child_monitoring"/>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Health Connect ruxsati nima uchun kerakligini tushuntirish
                 ekrani (Android 13 va past). -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>
        </activity>
        <!-- Health Connect ruxsat tushuntirishi — Android 14+ (targetSdk 35)
             uchun majburiy alias. -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="farzandim_child_default"/>

        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="location|dataSync"
            android:exported="false"
            android:stopWithTask="false"
            tools:replace="android:foregroundServiceType" />

        <service
            android:name=".RestrictionService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="App restriction enforcement for parental control"
                tools:targetApi="34"/>
        </service>

        <!-- ⏸️ BlockAccessibilityService VAQTINCHA OLIB TASHLANDI (2026-08-06):
             Google Play tekshiruvi APK yuklab olinayotgan paytda ("installing
             app") o'ta olmayapti — sabab shu servis (eng ko'p tekshiriladigan,
             cheklangan Android ruxsati) deb taxmin qilinmoqda. Avval
             accessibility'siz alohida tasdiqlangan reliz chiqaramiz, keyin
             buni alohida yangilanish sifatida qaytadan qo'shamiz.

             QAYTARISH: shu <service> blokini qayta yozing (Kotlin fayllar —
             BlockAccessibilityService.kt, BlockPolicy.kt — tegilmagan,
             o'zidan-o'zi tayyor turibdi) + permission_setup_screen.dart'dagi
             a11y qatorini qaytaring. Qarang: docs/BLOKLASH-QUVVATI-VA-A11Y-QARORI.md
             (2.4-band, "Rollback — aynan 2 joy"). -->

        <receiver
            android:name=".BootReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>

        <service
            android:name="io.flutter.plugins.firebase.messaging.FlutterFirebaseMessagingService"
            tools:node="remove"/>
        <service
            android:name=".FarzandimMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>

        <activity
            android:name=".RingActivity"
            android:exported="false"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.NoActionBar"
            tools:targetApi="27"/>

        <service
            android:name=".RingService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            tools:targetApi="34">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Ring the child device on parent request (find device)"
                tools:targetApi="34"/>
        </service>

        <service
            android:name="com.ryanheise.audioservice.AudioService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.media.browse.MediaBrowserService"/>
            </intent-filter>
        </service>
        <receiver
            android:name="com.ryanheise.audioservice.MediaButtonReceiver"
            android:exported="true"
            tools:ignore="Instantiatable">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON"/>
            </intent-filter>
        </receiver>

        <!-- Device Admin — "O'chirishni taqiqlash" (ota-ona yoqadi). Admin faol
             bo'lganda bola Farzandim ilovasini o'chira olmaydi (uninstall
             tugmasi sistemada o'chadi). Bola app device-policy.blockUninstall
             bo'yicha admin'ni yoqadi/o'chiradi. -->
        <receiver
            android:name=".FarzandimDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin"/>
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED"/>
            </intent-filter>
        </receiver>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="market"/>
        </intent>
    </queries>
</manifest>
