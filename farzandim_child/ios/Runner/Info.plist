<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>uz</string>
			<string>ru</string>
		</array>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Parvoz Growth</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>Parvoz Growth</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<false/>
		<!-- ─── Sprint 6 P2: iOS Lite — ruxsat tavsiflari ─── -->
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>Parvoz shares your location with your parents so they know you are safe.</string>
		<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
		<string>Parvoz shares your location with your parents even when the app is closed, so they know you are safe and get alerts when you arrive at or leave saved places.</string>
		<key>NSLocationAlwaysUsageDescription</key>
		<string>Parvoz shares your location with your parents even when the app is closed, so they know you are safe.</string>
		<key>NSCameraUsageDescription</key>
		<string>Parvoz uses the camera to scan your parent's pairing QR code and to send photo and video messages to your parents.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>Parvoz uses the microphone to record voice and video messages for your parents.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Parvoz lets you choose photos from your library to send to your parents.</string>
		<!-- pedometer plagini iOS'da CoreMotion ishlatadi. Bu matn bo'lmasa
		     iOS ilovani birinchi murojaatdayoq MAJBURAN yopadi (krash). -->
		<key>NSMotionUsageDescription</key>
		<string>Parvoz counts your daily steps with the motion sensor and shows them to your parents.</string>
		<!-- health plagini HealthKit'ni ulaydi: matnlar bo'lmasa App Store yuklashni
		     rad etadi (ITMS-90683). iOS'da qadamlar CoreMotion (pedometer) orqali. -->
		<key>NSHealthShareUsageDescription</key>
		<string>Parvoz counts steps with the iPhone motion sensor and does not read Apple Health data.</string>
		<key>NSHealthUpdateUsageDescription</key>
		<string>Parvoz does not write any data to Apple Health.</string>
		<!-- flutter_foreground_task ishga tushishda shu BGTask'ni ro'yxatdan o'tkazadi —
		     identifikator bu yerda bo'lmasa iOS ilovani darhol yopadi (krash). -->
		<key>BGTaskSchedulerPermittedIdentifiers</key>
		<array>
			<string>com.pravera.flutter_foreground_task.refresh</string>
		</array>
		<!-- Faqat standart HTTPS/TLS — eksport hujjati talab qilinmaydi. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Fon rejimlari: joylashuv + push + audiokitob background playback -->
		<key>UIBackgroundModes</key>
		<array>
			<string>location</string>
			<string>remote-notification</string>
			<string>fetch</string>
			<string>audio</string>
		</array>
	</dict>
</plist>
